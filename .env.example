# .env.example
# ---------------------------------------------------------------------
# This file (.env.example) is committed to the repo as a template.
# The real .env file is gitignored and must never be committed — it
# holds actual secrets (DB password, PROCESS_SECRET) for this machine.
# Copy this file to .env and fill in real values before running the app.
# ---------------------------------------------------------------------

PORT=3000
# Port the Express server listens on (server.js reads process.env.PORT || 3000).

NODE_ENV=development
# "development" or "production" — controls error verbosity (no stack traces either way, see errors/500.ejs).

DB_HOST=localhost
# Hostname of the MySQL 8 server.

DB_PORT=3306
# Port of the MySQL 8 server.

DB_USER=root
# MySQL user db.js uses to create the mysql2/promise connection pool.

DB_PASSWORD=your-database-password
# MySQL password for DB_USER — never commit a real value here.

DB_NAME=whereitis
# Database name created by schema.sql.

PROCESS_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Secret key used by lib/hmac.js to sign/verify the whereitis_id cookie (HMAC-SHA256). Must be kept secret and stable per deployment.

GOOGLE_CLIENT_ID=
# OAuth 2.0 Client ID (Web application) from Google Cloud Console > APIs & Services > Credentials.
# Leave empty to disable "Continue with Google". Add http://localhost:3000 and https://whereitis.xyz
# under Authorised JavaScript origins for that client. This value is public, not a secret.

MATCH_WINDOW_DAYS=30
# Number of days before/after occurred_on that the matching engine (lib/matching.js) considers a candidate match (FR-09).

GUEST_REPORTS_PER_DAY=3
# Optional. Most guest (no-account) reports one connection may send in 24 hours (routes/reports.js, lib/antispam.js). Defaults to 3.

HOLDING_PERIOD_DAYS=90
# Default number of days a found item is held before staff may archive it as unclaimed (FR-15).

APP_URL=http://localhost:3000
# Public address of the site. Used to build the link inside the verification email. Set to your real domain once hosted (e.g. https://whereitis.example.com).

BREVO_API_KEY=
# Brevo (free plan) API key: Brevo dashboard > SMTP & API > API Keys. Leave empty in development to print the verification link in the terminal instead of emailing it.

MAIL_FROM_EMAIL=
# Sender address for verification emails. Must be added and verified in Brevo > Senders, domains & dedicated IPs.

MAIL_FROM_NAME=CSPC WhereITis
# Sender display name shown in the inbox.

DB_SSL=true
# true = TLS to MySQL (required by the managed DB). Defaults to true when NODE_ENV=production; use false for local MySQL.

DB_SSL_REJECT_UNAUTHORIZED=true
# Keep true. Set false only if the provider's certificate chain cannot be verified (document it if you do).

# Optional: store sign-in sessions in MySQL (table `sessions`, created automatically).
# Leave unset to keep the original signed-cookie login. Set to "db" to turn it on.
# SESSION_STORE=db
