# .env.example
# ---------------------------------------------------------------------
# This file (.env.example) is committed to the repo as a template.
# The real .env file is gitignored and must never be committed — it
# holds actual secrets (DB password, PROCESS_SECRET) for this machine.
# Copy this file to .env and fill in real values before running the app.
# ---------------------------------------------------------------------

PORT=3000
# Port the Express server listens on (server.js reads process.env.PORT || 3000).

NODE_ENV=development
# "development" or "production" — controls error verbosity (no stack traces either way, see errors/500.ejs).

DB_HOST=localhost
# Hostname of the MySQL 8 server.

DB_PORT=3306
# Port of the MySQL 8 server.

DB_USER=root
# MySQL user db.js uses to create the mysql2/promise connection pool.

DB_PASSWORD=changeme
# MySQL password for DB_USER — never commit a real value here.

DB_NAME=whereitis
# Database name created by schema.sql.

PROCESS_SECRET=replace-this-with-a-long-random-string-before-running
# Secret key used by lib/hmac.js to sign/verify the whereitis_id cookie (HMAC-SHA256). Must be kept secret and stable per deployment.

MATCH_WINDOW_DAYS=30
# Number of days before/after occurred_on that the matching engine (lib/matching.js) considers a candidate match (FR-09).

HOLDING_PERIOD_DAYS=90
# Default number of days a found item is held before staff may archive it as unclaimed (FR-15).