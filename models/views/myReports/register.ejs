<!-- CSPC WhereITis — views/myReports/register.ejs -->
<%
  const _errors = errors || {};
  const _values = values || {};
  const _next = (typeof next !== 'undefined' && next) ? next : '';
  const _errorList = Object.keys(_errors).map(function (k) { return _errors[k]; });
  const _bad = function (k, hint) { return _errors[k] ? 'aria-invalid="true" aria-describedby="err-' + k + '"' : (hint ? 'aria-describedby="' + hint + '"' : ''); };
%>
<%- include('../partials/head', { title: 'Create an account' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Join WhereITis</h2>
        <p>Create your account to report lost and found items, file claims, and track everything in one place.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Create an account</h1>
      <p class="auth-panel__sub muted">Use your student number and CSPC school email.</p>

      <% if (_errorList.length) { %>
        <div class="form-alert auth-alert" role="alert" id="form-alert" tabindex="-1">
          <strong>Please fix the following:</strong>
          <ul><% _errorList.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
        </div>
      <% } %>

      <form method="post" action="/register" class="auth-form" novalidate data-auth-form>
        <% if (_next) { %><input type="hidden" name="next" value="<%= _next %>"><% } %>

        <div class="field">
          <label for="full_name">Full name</label>
          <input id="full_name" name="full_name" class="input input--lg" type="text" maxlength="120" required
                 autocomplete="name" placeholder="e.g. Juan Dela Cruz" value="<%= _values.full_name || '' %>" <%- _bad('full_name') %>>
          <% if (_errors.full_name) { %><p class="field-error" id="err-full_name"><%= _errors.full_name %></p><% } %>
        </div>

        <div class="field">
          <label for="student_no">Student number</label>
          <input id="student_no" name="student_no" class="input input--lg" type="text" inputmode="numeric" maxlength="10" pattern="\d{7,10}" title="Student number" required
                 autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="Your student number"
                 value="<%= _values.student_no || '' %>" <%- _bad('student_no') %>>
          <% if (_errors.student_no) { %><p class="field-error" id="err-student_no"><%= _errors.student_no %></p><% } %>
        </div>

        <div class="field">
          <label for="email">School email</label>
          <input id="email" name="email" class="input input--lg" type="email" maxlength="160" pattern="[^@\s]+@cspc\.edu\.ph" title="School email" required
                 autocomplete="email" placeholder="Your school email" value="<%= _values.email || '' %>" <%- _bad('email') %>>
          <% if (_errors.email) { %><p class="field-error" id="err-email"><%= _errors.email %></p><% } %>
        </div>

        <div class="field">
          <label for="contact_no">Contact number <span class="optional">(optional)</span></label>
          <input id="contact_no" name="contact_no" class="input input--lg" type="tel" maxlength="20"
                 autocomplete="tel" placeholder="e.g. 0917 123 4567" value="<%= _values.contact_no || '' %>" <%- _bad('contact_no', 'contact-hint') %>>
          <% if (_errors.contact_no) { %><p class="field-error" id="err-contact_no"><%= _errors.contact_no %></p><% } %>
          <p class="field-hint" id="contact-hint">Only used so staff can reach you about an item.</p>
        </div>

        <div class="field">
          <label for="pin">Choose a 4-digit PIN</label>
          <div class="pin-wrap">
            <input id="pin" name="pin" class="input input--lg" type="password" inputmode="numeric" pattern="\d{4}"
                   maxlength="4" required autocomplete="new-password" placeholder="&bull;&bull;&bull;&bull;" <%- _bad('pin') %>>
            <button type="button" class="pin-toggle" data-toggle-pin aria-controls="pin" aria-pressed="false">Show</button>
          </div>
          <% if (_errors.pin) { %><p class="field-error" id="err-pin"><%= _errors.pin %></p><% } %>
        </div>

        <div class="field">
          <label for="pin_confirm">Confirm PIN</label>
          <input id="pin_confirm" name="pin_confirm" class="input input--lg" type="password" inputmode="numeric" pattern="\d{4}"
                 maxlength="4" required autocomplete="new-password" placeholder="&bull;&bull;&bull;&bull;" <%- _bad('pin_confirm') %>>
          <% if (_errors.pin_confirm) { %><p class="field-error" id="err-pin_confirm"><%= _errors.pin_confirm %></p><% } %>
        </div>

        <label class="checkbox auth-remember">
          <input type="checkbox" name="agree" value="1" required>
          I agree to the <a href="/terms" target="_blank" rel="noopener">Terms</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy notice</a>.
        </label>

        <button type="submit" class="btn btn--primary auth-submit" data-submit>Create account</button>
      </form>

      <p class="auth-help">Already have an account? <a href="/sign-in<%= _next ? '?next=' + encodeURIComponent(_next) : '' %>"><strong>Sign in</strong></a></p>
      <p class="auth-back"><a href="/">&larr; Back to home</a></p>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
