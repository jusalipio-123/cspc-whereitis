<!-- CSPC WhereITis — views/messages/new.ejs -->
<%
  const _errors = errors || {};
  const _values = values || {};
%>
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <%- include('../partials/flash') %>

  <h1>Send a message</h1>
  <p>About <a href="/reports/<%= report.reference_no %>"><strong><%= report.title %></strong></a> (<code><%= report.reference_no %></code>), reported by <%= report.reporter_name %>.</p>

  <form method="post" action="/messages" class="form message-form" novalidate>
    <input type="hidden" name="report_reference" value="<%= report.reference_no %>">
    <div class="field">
      <label for="body">Your message</label>
      <textarea id="body" name="body" class="textarea" rows="5" maxlength="1000" required
                data-charcount data-charcount-max="1000"
                <%= _errors.body ? 'aria-invalid="true" aria-describedby="err-body"' : 'aria-describedby="hint-body"' %>><%= _values.body || '' %></textarea>
      <% if (_errors.body) { %><p class="field-error" id="err-body"><%= _errors.body %></p><% } %>
      <p class="field-hint" id="hint-body">Keep personal details like phone numbers out of messages. To collect an item, staff will verify ownership.</p>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn--primary">Send message</button>
      <a class="btn btn--ghost" href="/reports/<%= report.reference_no %>">Cancel</a>
    </div>
  </form>
</main>

<%- include('../partials/foot') %>
