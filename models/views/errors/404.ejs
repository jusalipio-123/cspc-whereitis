<!-- CSPC WhereITis — views/errors/404.ejs -->
<%- include('../partials/head', { title: 'Page not found' }) %>
<%- include('../partials/nav') %>

<main id="main" class="container error-page">
  <h1>Page not found</h1>
  <p>We couldn't find that page.</p>
  <p>You can <a href="/reports">search all reports</a> or
     <a href="/">go to the home page</a>.</p>
  <form method="get" action="/reports" class="form form--narrow">
    <label for="q-404">Search reports</label>
    <input id="q-404" name="q" class="input" type="search"
           placeholder="Item name, brand, colour…">
    <button class="btn btn--primary" type="submit">Search</button>
  </form>
</main>

<%- include('../partials/foot') %>