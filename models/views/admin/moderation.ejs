<!-- CSPC WhereITis — views/admin/moderation.ejs -->
<%
  const _fmt = function (d) { return d ? new Date(d).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : ''; };
  const _tabs = [['pending', 'Pending'], ['approved', 'Approved'], ['rejected', 'Rejected']];
%>
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <%- include('../partials/flash') %>

  <h1>Guest report review</h1>
  <p class="muted">Guest reports stay hidden from the public until a staff member approves them. Contact details below are for staff only.</p>

  <nav class="mod-tabs" aria-label="Review status">
    <% _tabs.forEach(function (t) { %>
      <a href="/admin/moderation?view=<%= t[0] %>" class="mod-tab"<%- view === t[0] ? ' aria-current="page"' : '' %>>
        <%= t[1] %><% if (t[0] === 'pending') { %> <span class="mod-count"><%= pendingCount %></span><% } %>
      </a>
    <% }); %>
    <a class="mod-tab mod-tab--end" href="/admin">&larr; Dashboard</a>
  </nav>

  <% if (reports.length === 0) { %>
    <div class="empty-state">
      <h3>Nothing here</h3>
      <p><%= view === 'pending' ? 'No guest reports are waiting for review.' : 'No ' + view + ' guest reports yet.' %></p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table table--mod">
        <thead>
          <tr>
            <th>Report</th><th>Where / when</th><th>Contact (staff only)</th>
            <th><%= view === 'pending' ? 'Decision' : 'Decided' %></th>
          </tr>
        </thead>
        <tbody>
          <% reports.forEach(function (r) { %>
            <tr>
              <td>
                <a href="/reports/<%= r.reference_no %>"><code><%= r.reference_no %></code></a>
                <strong class="mod-title"><%= r.title %></strong>
                <span class="muted"><%= r.category_name %></span>
                <p class="mod-desc"><%= r.description %></p>
                <% if (r.photo_url) { %><a href="<%= r.photo_url %>" target="_blank" rel="noopener"><img src="<%= r.photo_url %>" alt="Photo of <%= r.title %>" style="max-width:140px;max-height:100px;border-radius:6px;object-fit:cover" loading="lazy"></a><% } else { %><span class="muted">No photo</span><% } %>
                <% if (Number(r.same_source_24h) > 1) { %>
                  <span class="pill pill--matched" title="Guest reports from the same connection in the last 24 hours"><%= r.same_source_24h %> from same source today</span>
                <% } %>
              </td>
              <td>
                <%= r.location_name %><br>
                <span class="muted">Found <%= new Date(r.occurred_on).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span><br>
                <span class="muted">Held: <%= r.holding_location %></span><br>
                <span class="muted">Sent <%= _fmt(r.created_at) %></span>
              </td>
              <td>
                <% if (r.guest_contact_name || r.guest_contact_email || r.guest_contact_phone) { %>
                  <% if (r.guest_contact_name) { %><%= r.guest_contact_name %><br><% } %>
                  <% if (r.guest_contact_email) { %><%= r.guest_contact_email %><br><% } %>
                  <% if (r.guest_contact_phone) { %><%= r.guest_contact_phone %><% } %>
                <% } else { %><span class="muted">None given</span><% } %>
              </td>
              <td>
                <% if (view === 'pending') { %>
                  <form method="post" action="/admin/moderation/<%= r.reference_no %>/approve" class="mod-form">
                    <button class="btn btn--primary btn--sm" type="submit">Approve</button>
                  </form>
                  <form method="post" action="/admin/moderation/<%= r.reference_no %>/reject" class="mod-form">
                    <label class="visually-hidden" for="note-<%= r.id %>">Reason for rejecting <%= r.reference_no %></label>
                    <input id="note-<%= r.id %>" name="note" class="input" type="text" minlength="5" maxlength="255" required placeholder="Reason (min. 5 characters)">
                    <button class="btn btn--danger btn--sm" type="submit">Reject</button>
                  </form>
                <% } else { %>
                  <span class="pill pill--<%= r.moderation_status === 'approved' ? 'returned' : 'archived' %>"><%= r.moderation_status %></span><br>
                  <span class="muted"><%= r.moderator_name || 'Unknown' %> &middot; <%= _fmt(r.moderated_at) %></span>
                  <% if (r.moderation_note) { %><p class="mod-desc"><%= r.moderation_note %></p><% } %>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
