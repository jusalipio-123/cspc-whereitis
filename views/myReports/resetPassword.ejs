<!-- CSPC WhereITis — views/myReports/resetPassword.ejs -->
<%
  const _errors = errors || {};
  const _errorList = Object.keys(_errors).map(function (k) { return _errors[k]; });
  const _bad = function (k, hint) { return _errors[k] ? 'aria-invalid="true" aria-describedby="err-' + k + '"' : (hint ? 'aria-describedby="' + hint + '"' : ''); };
%>
<%- include('../partials/head', { title: 'Choose a new password' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Almost there</h2>
        <p>Choose a strong password you have not used on another account. Your old password will stop working immediately.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Choose a new password</h1>
      <p class="auth-panel__sub muted">Enter the 6-digit code we emailed to <strong><%= email %></strong>, then choose a new password. The code expires in 10 minutes.</p>

      <% if (_errorList.length) { %>
        <div class="form-alert auth-alert" role="alert" id="form-alert" tabindex="-1">
          <strong>Please fix the following:</strong>
          <ul><% _errorList.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
        </div>
      <% } %>

      <form method="post" action="/reset-password" class="auth-form" novalidate data-auth-form>
        <div class="field">
          <label for="code">6-digit code</label>
          <input id="code" name="code" class="input input--lg" type="text" inputmode="numeric" pattern="[0-9 ]*"
                 autocomplete="one-time-code" required autocapitalize="off" spellcheck="false" placeholder="000000" data-otp-input
                 style="letter-spacing:.4em;text-align:center;font-size:1.6rem;font-weight:700;padding-left:.4em" <%- _bad('code', 'code-help') %>>
          <% if (_errors.code) { %><p class="field-error" id="err-code"><%= _errors.code %></p><% } %>
          <p class="field-hint" id="code-help">Can't find the email? Check your spam or junk folder.</p>
        </div>

        <div class="field">
          <label for="password">New password</label>
          <div class="pin-wrap pin-wrap--password">
            <input id="password" name="password" class="input input--lg" type="password" minlength="10"
                   maxlength="128" required autocomplete="new-password" placeholder="At least 10 characters" <%- _bad('password', 'pw-help') %>>
            <button type="button" class="pin-toggle" data-toggle-password aria-controls="password password_confirm" aria-pressed="false">Show</button>
          </div>
          <%- include('../partials/passwordMeter') %>
          <% if (_errors.password) { %><p class="field-error" id="err-password"><%= _errors.password %></p><% } %>
          <p class="field-hint" id="pw-help">Use 10+ characters with letters and numbers or symbols. Avoid your name, ID number or common words.</p>
        </div>

        <div class="field">
          <label for="password_confirm">Confirm new password</label>
          <input id="password_confirm" name="password_confirm" class="input input--lg" type="password"
                 maxlength="128" required autocomplete="new-password" placeholder="Type it again" <%- _bad('password_confirm') %>>
          <% if (_errors.password_confirm) { %><p class="field-error" id="err-password_confirm"><%= _errors.password_confirm %></p><% } %>
        </div>

        <button type="submit" class="btn btn--primary auth-submit" data-submit>Save new password</button>
      </form>

      <form method="post" action="/verify-code/resend" class="auth-form" data-otp-form>
        <button type="submit" class="btn btn--ghost auth-submit" data-resend data-wait="<%= Number(typeof resendWaitSec !== 'undefined' ? resendWaitSec : 0) || 0 %>">Resend code</button>
      </form>

      <p class="auth-help auth-links">
        <a href="/sign-in">&larr; Back to sign in</a>
      </p>
    </section>
  </div>
</main>

<script src="/js/otp.js" defer></script>
<%- include('../partials/foot') %>
