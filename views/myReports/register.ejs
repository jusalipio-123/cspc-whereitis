<!-- CSPC WhereITis — views/myReports/register.ejs — single-page registration -->
<%
  const _errors = errors || {};
  const _values = values || {};
  const _next = (typeof next !== 'undefined' && next) ? next : '';
  const _errorList = Object.keys(_errors).map(function (k) { return _errors[k]; });
  const _bad = function (k, hint) { return _errors[k] ? 'aria-invalid="true" aria-describedby="err-' + k + '"' : (hint ? 'aria-describedby="' + hint + '"' : ''); };
%>
<%- include('../partials/head', { title: 'Create an account' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card auth-card--wide">
    <aside class="auth-brand">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Join WhereITis</h2>
        <p>Create one account to report lost and found items, file claims and follow every update in one place.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Create an account</h1>
      <p class="auth-panel__sub muted">Complete all fields. Administrator accounts are not created here.</p>

      <% if (_errorList.length) { %>
        <div class="form-alert auth-alert" role="alert" id="form-alert" tabindex="-1">
          <strong>Please fix the following:</strong>
          <ul><% _errorList.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
        </div>
      <% } %>

      <form method="post" action="/register" class="auth-form auth-form--grid" novalidate data-auth-form>
        <% if (_next) { %><input type="hidden" name="next" value="<%= _next %>"><% } %>

        <div class="field field--wide">
          <label for="full_name">Full name</label>
          <input id="full_name" name="full_name" class="input input--lg" type="text" maxlength="120" required
                 autocomplete="name" placeholder="e.g. Juan Dela Cruz" value="<%= _values.full_name || '' %>" <%- _bad('full_name') %>>
          <% if (_errors.full_name) { %><p class="field-error" id="err-full_name"><%= _errors.full_name %></p><% } %>
        </div>

        <div class="field">
          <label for="role">Role</label>
          <select id="role" name="role" class="select input--lg" required <%- _bad('role') %>>
            <option value="">Choose your role</option>
            <option value="student"<%- _values.role === 'student' ? ' selected' : '' %>>Student</option>
            <option value="staff"<%- _values.role === 'staff' ? ' selected' : '' %>>Staff</option>
            <option value="teacher"<%- _values.role === 'teacher' ? ' selected' : '' %>>Teacher</option>
          </select>
          <% if (_errors.role) { %><p class="field-error" id="err-role"><%= _errors.role %></p><% } %>
        </div>

        <div class="field">
          <label for="student_no">Student / Staff ID number</label>
          <input id="student_no" name="student_no" class="input input--lg" type="text" maxlength="20"
                 pattern="[A-Za-z0-9-]{5,20}" title="5-20 letters, numbers or hyphens" required
                 autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="e.g. 2024-00123 or STF-00045"
                 value="<%= _values.student_no || '' %>" <%- _bad('student_no') %>>
          <% if (_errors.student_no) { %><p class="field-error" id="err-student_no"><%= _errors.student_no %></p><% } %>
        </div>

        <div class="field field--wide">
          <label for="email">Email address</label>
          <input id="email" name="email" class="input input--lg" type="email" maxlength="160" pattern="[^@\s]+@(my\.)?cspc\.edu\.ph"
                 title="Use your CSPC email, e.g. name@my.cspc.edu.ph" required
                 autocomplete="email" placeholder="name@my.cspc.edu.ph" value="<%= _values.email || '' %>" <%- _bad('email') %>>
          <% if (_errors.email) { %><p class="field-error" id="err-email"><%= _errors.email %></p><% } %>
        </div>

        <div class="field field--stack-mobile">
          <label for="password">Create a password</label>
          <div class="pin-wrap pin-wrap--password">
            <input id="password" name="password" class="input input--lg" type="password" minlength="10"
                   maxlength="128" required autocomplete="new-password" placeholder="At least 10 characters" <%- _bad('password', 'pw-help') %>>
            <button type="button" class="pin-toggle" data-toggle-password aria-controls="password password_confirm" aria-pressed="false">Show</button>
          </div>
          <%- include('../partials/passwordMeter') %>
          <% if (_errors.password) { %><p class="field-error" id="err-password"><%= _errors.password %></p><% } %>
          <p class="field-hint" id="pw-help">Use 10+ characters with letters and numbers or symbols. Avoid your name, ID number or common words.</p>
        </div>

        <div class="field field--stack-mobile">
          <label for="password_confirm">Confirm password</label>
          <input id="password_confirm" name="password_confirm" class="input input--lg" type="password"
                 maxlength="128" required autocomplete="new-password" placeholder="Type it again" <%- _bad('password_confirm') %>>
          <% if (_errors.password_confirm) { %><p class="field-error" id="err-password_confirm"><%= _errors.password_confirm %></p><% } %>
        </div>

        <label class="checkbox auth-remember field--wide">
          <input type="checkbox" name="agree" value="1" required>
          <span>I agree to the <a href="/terms" target="_blank" rel="noopener">Terms</a> and <a href="/privacy" target="_blank" rel="noopener">Privacy notice</a>.</span>
        </label>

        <button type="submit" class="btn btn--primary auth-submit field--wide" data-submit>Create account</button>
      </form>

      <a class="auth-google" href="https://accounts.google.com/" target="_blank" rel="noopener noreferrer"
         aria-label="Continue with Google account (opens Google Account in a new tab)"
         title="Open Google Account in a new tab">
        <span class="auth-google__label" aria-hidden="true">continue with</span>
        <span class="auth-google__logo" aria-hidden="true">
          <svg viewBox="0 0 48 48" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
        </span>
      </a>

      <p class="auth-help auth-links">
        Already have an account? <a href="/sign-in<%= _next ? '?next=' + encodeURIComponent(_next) : '' %>">Sign in</a>
      </p>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
