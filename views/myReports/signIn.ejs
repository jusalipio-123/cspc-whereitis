<!-- CSPC WhereITis — views/myReports/signIn.ejs -->
<%
  const _errors = errors || {};
  const _errorList = [_errors.email, _errors.password].filter(Boolean);
  const _values = values || {};
  const _next = (typeof next !== 'undefined' && next) ? next : '';
  const _reason = _next.indexOf('/reports/new') === 0 ? 'Sign in to submit your report.'
                : _next.indexOf('/claims') === 0 ? 'Sign in to continue with your claim.'
                : _next ? 'Sign in to continue.' : 'Use your CSPC email address and password.';
%>
<%- include('../partials/head', { title: 'Sign in' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand" aria-hidden="false">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Welcome back</h2>
        <p>Sign in to track the items you reported, follow your claims and keep your CSPC community connected.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Sign in</h1>
      <p class="auth-panel__sub muted"><%= _reason %></p>

      <% if (_errorList.length) { %>
        <div class="form-alert auth-alert" role="alert" id="auth-alert">
          <%= _errorList[0] %>
        </div>
      <% } %>

      <%- include('../partials/googleButton', { next: _next, placement: 'top' }) %>

      <form method="post" action="/sign-in" class="auth-form" novalidate data-auth-form>
        <% if (_next) { %><input type="hidden" name="next" value="<%= _next %>"><% } %>

        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" class="input input--lg" type="email" maxlength="160" required
                 autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="name@my.cspc.edu.ph"
                 value="<%= _values.email || '' %>"
                 <%= _errors.email ? 'aria-invalid="true" aria-describedby="auth-alert"' : '' %>>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="pin-wrap pin-wrap--password">
            <input id="password" name="password" class="input input--lg" type="password"
                   maxlength="128" required autocomplete="current-password" placeholder="Your password"
                   <%= _errors.password ? 'aria-invalid="true" aria-describedby="auth-alert"' : 'aria-describedby="password-hint"' %>>
            <button type="button" class="pin-toggle" data-toggle-password aria-controls="password" aria-pressed="false">Show</button>
          </div>
          <p class="field-hint" id="password-hint">Old account? Type your 4-digit PIN once. We will ask you to choose a new password.</p>
        </div>

        <p class="auth-forgot"><a href="/forgot-password">Forgot password?</a></p>

        <label class="checkbox auth-remember">
          <input type="checkbox" name="remember" data-remember-email>
          Remember my email address on this device
        </label>

        <button type="submit" class="btn btn--primary auth-submit" data-submit>Sign in</button>
      </form>

      <p class="auth-help auth-links">
        New here? <a href="/register<%= _next ? '?next=' + encodeURIComponent(_next) : '' %>">Create an account</a>
      </p>
      <p class="auth-help auth-links">
        Trouble signing in? <a href="/help">Help</a>
      </p>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
