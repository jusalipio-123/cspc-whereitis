<!-- CSPC WhereITis — views/myReports/forgotPassword.ejs -->
<%
  const _errors = errors || {};
  const _values = values || {};
  const _errorList = [_errors.email].filter(Boolean);
%>
<%- include('../partials/head', { title: 'Forgot your password?' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Reset your password</h2>
        <p>Enter the email address you use to sign in. We will send a short-lived link so you can choose a new password.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Forgot your password?</h1>
      <p class="auth-panel__sub muted">If an account matches this email, a reset link will be sent.</p>

      <% if (_errorList.length) { %>
        <div class="form-alert auth-alert" role="alert" id="auth-alert">
          <%= _errorList[0] %>
        </div>
      <% } %>

      <form method="post" action="/forgot-password" class="auth-form" novalidate data-auth-form>
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" class="input input--lg" type="email" maxlength="160" required
                 autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="name@my.cspc.edu.ph"
                 value="<%= _values.email || '' %>"
                 <%= _errors.email ? 'aria-invalid="true" aria-describedby="auth-alert"' : '' %>>
        </div>

        <button type="submit" class="btn btn--primary auth-submit" data-submit>Send reset link</button>
      </form>

      <p class="auth-help auth-links">
        Remembered it? <a href="/sign-in">Back to sign in</a>
      </p>
      <p class="auth-help auth-links">
        Need help? <a href="/help">Contact support</a>
      </p>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
