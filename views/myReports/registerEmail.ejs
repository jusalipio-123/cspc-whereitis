<!-- CSPC WhereITis — views/myReports/registerEmail.ejs — registration step 1: email only -->
<%
  const _errors = errors || {};
  const _values = values || {};
  const _next = (typeof next !== 'undefined' && next) ? next : '';
%>
<%- include('../partials/head', { title: 'Create an account' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Join WhereITis</h2>
        <p>Create one account to report lost and found items, file claims and follow every update in one place.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Create an account</h1>
      <p class="auth-panel__sub muted">Step 1 of 2: confirm your CSPC email. We will send you a 6-digit code.</p>

      <% if (_errors.email) { %>
        <div class="form-alert auth-alert" role="alert" id="auth-alert"><%= _errors.email %></div>
      <% } %>

      <form method="post" action="/register" class="auth-form" data-otp-form>
        <% if (_next) { %><input type="hidden" name="next" value="<%= _next %>"><% } %>

        <div class="field">
          <label for="email">CSPC email address</label>
          <input id="email" name="email" class="input input--lg" type="email" maxlength="160" required autofocus
                 pattern="[^@\s]+@(my\.)?cspc\.edu\.ph" title="Use your CSPC email, e.g. name@my.cspc.edu.ph"
                 autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="name@my.cspc.edu.ph"
                 value="<%= _values.email || '' %>"
                 <%- _errors.email ? 'aria-invalid="true" aria-describedby="auth-alert"' : '' %>>
        </div>

        <button type="submit" class="btn btn--primary auth-submit" data-submit data-busy-label="Sending&hellip;">Send me a code</button>
      </form>

      <%- include('../partials/googleButton', { next: _next, mode: 'signup' }) %>

      <p class="auth-help auth-links">
        Already have an account? <a href="/sign-in<%= _next ? '?next=' + encodeURIComponent(_next) : '' %>">Sign in</a>
      </p>
    </section>
  </div>
</main>

<script src="/js/otp.js" defer></script>
<%- include('../partials/foot') %>
