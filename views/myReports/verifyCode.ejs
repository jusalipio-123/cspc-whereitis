<!-- CSPC WhereITis — views/myReports/verifyCode.ejs — type the 6-digit email code (registration / unverified sign-in) -->
<%
  const _errors = errors || {};
  const _next = (typeof next !== 'undefined' && next) ? next : '';
  const _wait = Number(typeof resendWaitSec !== 'undefined' ? resendWaitSec : 0) || 0;
  const _isRegister = purpose === 'register';
%>
<%- include('../partials/head', { title: 'Enter your code' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>One more step</h2>
        <p>We need to confirm that this email address is yours. Type the code we just emailed you.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <h1 id="auth-title">Enter your code</h1>
      <p class="auth-panel__sub muted">We sent a 6-digit code to <strong><%= email %></strong>. It expires in 10 minutes.</p>

      <% if (_errors.code) { %>
        <div class="form-alert auth-alert" role="alert" id="auth-alert"><%= _errors.code %></div>
      <% } %>

      <form method="post" action="<%= purpose === 'reset' ? '/reset-password' : '/verify-code' %>" class="auth-form" data-otp-form>
        <% if (_next) { %><input type="hidden" name="next" value="<%= _next %>"><% } %>
        <div class="field">
          <label for="code">6-digit code</label>
          <input id="code" name="code" class="input input--lg" type="text" inputmode="numeric" pattern="[0-9 ]*"
                 autocomplete="one-time-code" required autofocus autocapitalize="off" spellcheck="false"
                 placeholder="000000" data-otp-input data-autosubmit
                 style="letter-spacing:.4em;text-align:center;font-size:1.6rem;font-weight:700;padding-left:.4em"
                 <%- _errors.code ? 'aria-invalid="true" aria-describedby="auth-alert"' : 'aria-describedby="code-help"' %>>
          <p class="field-hint" id="code-help">It is sent automatically when you type all 6 digits. Can't find the email? Check your spam or junk folder.</p>
        </div>
        <button type="submit" class="btn btn--primary auth-submit" data-submit data-busy-label="Checking&hellip;">Verify</button>
      </form>

      <form method="post" action="/verify-code/resend" class="auth-form" data-otp-form style="margin-top:.85rem">
        <% if (_next) { %><input type="hidden" name="next" value="<%= _next %>"><% } %>
        <button type="submit" class="btn btn--ghost auth-submit" data-resend data-wait="<%= _wait %>">Resend code</button>
      </form>

      <p class="auth-help auth-links">
        <% if (purpose === 'reset') { %>
          <a href="/forgot-password">&larr; Use a different email</a>
        <% } else if (_isRegister) { %>
          <a href="/register<%= _next ? '?next=' + encodeURIComponent(_next) : '' %>">&larr; Use a different email</a>
        <% } else { %>
          <a href="/sign-in">&larr; Back to sign in</a>
        <% } %>
      </p>
    </section>
  </div>
</main>

<script src="/js/otp.js" defer></script>
<%- include('../partials/foot') %>
