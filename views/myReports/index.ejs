<!-- CSPC WhereITis — views/myReports/index.ejs -->
<%
  const _name = (typeof profileName !== 'undefined' && profileName) ? profileName : identity.studentNo;
  const _initials = _name.split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w.charAt(0); }).join('').toUpperCase() || 'U';
  const _pendingIncoming = incomingClaims.filter(function (c) { return c.status === 'pending'; }).length;
  const _pillFor = function (st) { return st === 'approved' ? 'returned' : st === 'rejected' ? 'archived' : 'open'; };
%>
<%- include('../partials/head', { title: 'My Reports' }) %>
<%- include('../partials/nav') %>

<main id="main" class="container my-page">
  <%- include('../partials/flash') %>

  <header class="my-hero card">
    <div class="my-hero__who">
      <span class="my-hero__avatar" aria-hidden="true"><%= _initials %></span>
      <div>
        <p class="page-head__eyebrow">My Reports</p>
        <h1 class="my-hero__name"><%= _name %></h1>
        <p class="my-hero__sub muted">Student no. <%= identity.studentNo %></p>
      </div>
    </div>
    <div class="my-hero__actions">
      <a class="btn btn--primary btn--sm" href="/reports/new">Report an item</a>
      <form method="post" action="/my-reports/sign-out" class="inline" data-confirm="Sign out of My Reports?">
        <button type="submit" class="btn btn--ghost btn--sm">Sign out</button>
      </form>
    </div>
  </header>

  <ul class="my-stats" aria-label="Summary">
    <li><a href="#my-reports-h"><strong><%= reports.length %></strong><span>My reports</span></a></li>
    <li><a href="#incoming-h"><strong><%= incomingClaims.length %></strong><span>Claims on my items<% if (_pendingIncoming) { %> <em><%= _pendingIncoming %> to review</em><% } %></span></a></li>
    <li><a href="#my-claims-h"><strong><%= claims.length %></strong><span>My claims</span></a></li>
  </ul>

  <section class="my-section" aria-labelledby="my-reports-h">
    <div class="my-section__head">
      <h2 id="my-reports-h">My reports <span class="my-count"><%= reports.length %></span></h2>
      <a class="btn btn--ghost btn--sm" href="/reports/new">New report</a>
    </div>
    <% if (reports.length === 0) { %>
      <div class="empty-state">
        <p>You haven't filed any reports yet.</p>
        <a class="btn btn--primary" href="/reports/new">Report an item</a>
      </div>
    <% } else { %>
      <ul class="card-grid card-grid--compact">
        <% reports.forEach(function (r) { %>
          <li><%- include('../partials/reportCard', { report: r }) %></li>
        <% }); %>
      </ul>
    <% } %>
  </section>

  <div class="my-columns">
    <section class="my-section" aria-labelledby="incoming-h">
      <div class="my-section__head"><h2 id="incoming-h">Claims on my reports <span class="my-count"><%= incomingClaims.length %></span></h2></div>
      <% if (incomingClaims.length === 0) { %>
        <div class="empty-state"><p>Nobody has claimed one of your items yet. New claims show up here, and a number appears on your profile icon.</p></div>
      <% } else { %>
        <ul class="claim-list claim-list--my">
          <% incomingClaims.forEach(function (c) { %>
            <li class="claim-row">
              <div class="claim-row__main">
                <strong><%= c.report_title %></strong>
                <span class="muted">by <%= c.claimant_name %> &middot; <%= fmtDateTime(c.created_at) %></span>
              </div>
              <div class="claim-row__side">
                <span class="pill pill--<%= _pillFor(c.status) %>"><%= c.status %></span>
                <a href="/claims/<%= c.id %>"><%= c.status === 'pending' ? 'Review' : 'View' %></a>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>

    <section class="my-section" aria-labelledby="my-claims-h">
      <div class="my-section__head"><h2 id="my-claims-h">My claims <span class="my-count"><%= claims.length %></span></h2></div>
      <% if (claims.length === 0) { %>
        <div class="empty-state"><p>You haven't filed any claims yet.</p></div>
      <% } else { %>
        <ul class="claim-list claim-list--my">
          <% claims.forEach(function (c) { %>
            <li class="claim-row">
              <div class="claim-row__main">
                <strong><%= c.report_title %></strong>
                <span class="muted">Claim #<%= c.id %> &middot; <%= fmtDateTime(c.created_at) %></span>
              </div>
              <div class="claim-row__side">
                <span class="pill pill--<%= _pillFor(c.status) %>"><%= c.status %></span>
                <a href="/claims/<%= c.id %>">View</a>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
