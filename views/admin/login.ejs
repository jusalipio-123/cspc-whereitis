<!-- CSPC WhereITis — views/admin/login.ejs -->
<!-- Temporary administrator sign-in. The admin interface is being rebuilt. -->
<%
  const _errors = errors || {};
  const _values = values || {};
  const _errorList = [_errors.email, _errors.password].filter(Boolean);
%>
<%- include('../partials/head', { title: 'Administrator sign in' }) %>
<%- include('../partials/nav', { hideAuthActions: true }) %>

<main id="main" class="auth-main auth-main--compact">
  <div class="auth-slides" aria-hidden="true">
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
    <span class="auth-slide"></span>
  </div>
  <%- include('../partials/flash') %>

  <div class="auth-card">
    <aside class="auth-brand" aria-hidden="false">
      <div class="auth-brand__top">
        <img class="auth-brand__seal" src="/img/logo.png" alt="" width="56" height="56" onerror="this.style.display='none';">
        <p class="auth-brand__name">CSPC WhereITis<span>Lost &amp; Found</span></p>
      </div>
      <div class="auth-brand__copy">
        <h2>Administrator</h2>
        <p>This sign-in is reserved for accounts whose database role is Administrator. Student, staff and teacher accounts cannot enter here.</p>
      </div>
      <p class="auth-brand__foot">Camarines Sur Polytechnic Colleges</p>
    </aside>

    <section class="auth-panel" aria-labelledby="admin-auth-title">
      <h1 id="admin-auth-title">Administrator sign in</h1>
      <p class="auth-panel__sub muted">Use your CSPC email address and administrator password.</p>

      <% if (_errorList.length) { %>
        <div class="form-alert auth-alert" role="alert" id="auth-alert">
          <%= _errorList[0] %>
        </div>
      <% } %>

      <form method="post" action="/admin/login" class="auth-form" novalidate data-auth-form>
        <div class="field">
          <label for="email">Email address</label>
          <input id="email" name="email" class="input input--lg" type="email" maxlength="160" required
                 autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="name@cspc.edu.ph"
                 value="<%= _values.email || '' %>"
                 <%= _errors.email ? 'aria-invalid="true" aria-describedby="auth-alert"' : '' %>>
        </div>

        <div class="field">
          <label for="password">Password</label>
          <div class="pin-wrap pin-wrap--password">
            <input id="password" name="password" class="input input--lg" type="password"
                   maxlength="128" required autocomplete="current-password" placeholder="Your password"
                   <%= _errors.password ? 'aria-invalid="true" aria-describedby="auth-alert"' : '' %>>
            <button type="button" class="pin-toggle" data-toggle-password aria-controls="password" aria-pressed="false">Show</button>
          </div>
        </div>

        <p class="auth-forgot"><a href="/forgot-password">Forgot password?</a></p>

        <button type="submit" class="btn btn--primary auth-submit" data-submit>Sign in</button>
      </form>

      <a class="auth-google" href="https://accounts.google.com/" target="_blank" rel="noopener noreferrer"
         aria-label="Continue with Google account (opens Google Account in a new tab)"
         title="Open Google Account in a new tab">
        <span class="auth-google__label" aria-hidden="true">continue with</span>
        <span class="auth-google__logo" aria-hidden="true">
          <svg viewBox="0 0 48 48" focusable="false">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
        </span>
      </a>

      <p class="auth-help auth-links">
        <a href="/sign-in">&larr; Regular sign in</a>
      </p>
    </section>
  </div>
</main>
