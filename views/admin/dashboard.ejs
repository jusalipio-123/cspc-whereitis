<!-- CSPC WhereITis — views/admin/dashboard.ejs -->
<%
  // NOTE: routes/admin.js (GET /admin) passes monthlyCounts,
  // categoryDistribution, topLocations, returnedThisMonth, agingOver60,
  // and statusCounts — those exact keys are used below rather than the
  // shorthand names (monthly/categoryDist/aging60) so this view matches
  // what the route actually renders with.
%>
<% const _bd = (typeof adminBadges !== 'undefined' && adminBadges) || { guestPending: 0, claimsPending: 0 }; %>
<%- include('../partials/adminOpen', { title: 'Admin dashboard', active: 'overview' }) %>

  <header class="page-head">
    <div>
      <p class="page-head__eyebrow">Admin console</p>
      <h1>Overview</h1>
      <p class="muted">What needs your attention, and what is happening on the site.</p>
    </div>
  </header>

  <ul class="my-stats" aria-label="Summary">
    <li><a href="/admin/moderation"><strong><%= _bd.guestPending %></strong><span>Guest reports to review<% if (_bd.guestPending) { %> <em>Needs review</em><% } %></span></a></li>
    <li><a href="/admin/staff"><strong><%= _bd.claimsPending %></strong><span>Claims waiting<% if (_bd.claimsPending) { %> <em>Needs a decision</em><% } %></span></a></li>
    <li><a href="/admin/reports"><strong><%= stats.reportsTotal %></strong><span>Total reports (<%= stats.reportsOpen %> open)</span></a></li>
    <li><a href="/admin/reports?moderation=rejected"><strong><%= stats.reportsHidden %></strong><span>Hidden or rejected</span></a></li>
    <li><a href="/admin/comments"><strong><%= stats.commentsTotal %></strong><span>Comments</span></a></li>
    <li><a href="/admin/users"><strong><%= stats.usersTotal %></strong><span>Users</span></a></li>
    <li><a href="/admin/reports?status=returned"><strong><%= returnedThisMonth %></strong><span>Returned this month</span></a></li>
    <li><a href="/admin/staff"><strong><%= agingOver60 %></strong><span>Held over 60 days</span></a></li>
  </ul>

  <div class="adm-cols">
    <section aria-labelledby="recent-r-h">
      <div class="my-section__head"><h2 id="recent-r-h">Latest reports</h2><a class="btn btn--ghost btn--sm" href="/admin/reports">Manage all</a></div>
      <div class="registry-wrap"><table class="registry">
        <thead><tr><th scope="col">Report</th><th scope="col">Visibility</th><th scope="col">Reported</th></tr></thead>
        <tbody>
          <% recentReports.forEach(function (r) { %>
            <tr>
              <td><a class="registry__title" href="/reports/<%= r.reference_no %>"><%= r.title %></a> <code class="registry__ref"><%= r.reference_no %></code></td>
              <td><span class="adm-tag<%= r.moderation_status === 'pending' ? ' adm-tag--strong' : (r.moderation_status === 'rejected' ? ' adm-tag--muted' : '') %>"><%= r.moderation_status === 'approved' ? 'Public' : (r.moderation_status === 'pending' ? 'Awaiting review' : 'Hidden') %></span></td>
              <td><%= fmtDate(r.created_at) %></td>
            </tr>
          <% }); %>
          <% if (!recentReports.length) { %><tr><td colspan="3" class="muted">No reports yet.</td></tr><% } %>
        </tbody>
      </table></div>
    </section>
    <section aria-labelledby="recent-c-h">
      <div class="my-section__head"><h2 id="recent-c-h">Latest comments</h2><a class="btn btn--ghost btn--sm" href="/admin/comments">Manage all</a></div>
      <div class="registry-wrap"><table class="registry">
        <thead><tr><th scope="col">Comment</th><th scope="col">By</th></tr></thead>
        <tbody>
          <% recentComments.forEach(function (c) { %>
            <tr>
              <td class="adm-wrap"><%= c.body.length > 90 ? c.body.slice(0, 90) + '…' : c.body %> <a class="adm-small" href="/reports/<%= c.reference_no %>"><%= c.reference_no %></a></td>
              <td><%= c.author_name %></td>
            </tr>
          <% }); %>
          <% if (!recentComments.length) { %><tr><td colspan="2" class="muted">No comments yet.</td></tr><% } %>
        </tbody>
      </table></div>
    </section>
  </div>

  <section aria-labelledby="source-h">
    <h2 id="source-h">Reports by source</h2>
    <p class="muted">Guest reports are reviewed by staff before they are public.
      <% if (sourceBreakdown.guest.pending > 0) { %>
        <a href="/admin/moderation"><strong><%= sourceBreakdown.guest.pending %> waiting for review</strong></a>.
      <% } else { %>
        <a href="/admin/moderation">Open the review queue</a>.
      <% } %>
    </p>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Source</th><th>Approved</th><th>Pending review</th><th>Rejected</th><th>Total</th></tr></thead>
        <tbody>
          <% [['registered', 'Registered users'], ['guest', 'Guests']].forEach(function (s) {
               const c = sourceBreakdown[s[0]]; %>
            <tr>
              <td><strong><%= s[1] %></strong></td>
              <td><%= c.approved %></td><td><%= c.pending %></td><td><%= c.rejected %></td>
              <td><%= c.approved + c.pending + c.rejected %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="monthly-h">
    <h2 id="monthly-h">Monthly counts (last 12 months)</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Month</th><th>Kind</th><th>Count</th></tr></thead>
        <tbody>
          <% monthlyCounts.forEach(function (m) { %>
            <tr><td><%= m.ym %></td><td><%= m.kind %></td><td><%= m.n %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="cat-h">
    <h2 id="cat-h">Category distribution</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Category</th><th>Reports</th></tr></thead>
        <tbody>
          <% categoryDistribution.forEach(function (c) { %>
            <tr><td><%= c.name %></td><td><%= c.n %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="loc-h">
    <h2 id="loc-h">Top locations</h2>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Location</th><th>Reports</th></tr></thead>
        <tbody>
          <% topLocations.forEach(function (l) { %>
            <tr><td><%= l.name %></td><td><%= l.n %></td></tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <p>
    <a class="btn btn--primary" href="/admin/export.csv">Export current month CSV</a>
    <a class="btn btn--ghost" href="/admin/bulk">Bulk status update</a>
    <a class="btn btn--ghost" href="/admin/moderation">Guest report review<% if (sourceBreakdown.guest.pending > 0) { %> (<%= sourceBreakdown.guest.pending %>)<% } %></a>
  </p>
<%- include('../partials/adminClose') %>