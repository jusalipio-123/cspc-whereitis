<!-- CSPC WhereITis — views/admin/dashboard.ejs -->
<%
  // NOTE: routes/admin.js (GET /admin) passes monthlyCounts,
  // categoryDistribution, topLocations, returnedThisMonth, agingOver60,
  // and statusCounts — those exact keys are used below rather than the
  // shorthand names (monthly/categoryDist/aging60) so this view matches
  // what the route actually renders with.
%>
<% const _bd = (typeof adminBadges !== 'undefined' && adminBadges) || { guestPending: 0, claimsPending: 0 }; %>
<%- include('../partials/adminOpen', { title: 'Admin dashboard', active: 'overview' }) %>
  <script>document.documentElement.classList.add('adm-anim');setTimeout(function(){if(!window.__admReady){var a=document.querySelectorAll('.adm-reveal');for(var i=0;i<a.length;i++){a[i].classList.add('is-in');}}},3500);</script>

  <%
    // Greeting in Philippine time (the whole app runs on PST), by the signed-in admin's first name.
    const _hr = parseInt(phParts().hour, 10);
    const _first = String((typeof profileName !== 'undefined' && profileName) || '').trim().split(/\s+/)[0];
    const _greet = _hr >= 5 && _hr < 12 ? 'Good morning' : (_hr >= 12 && _hr < 18 ? 'Good afternoon' : (_hr >= 18 && _hr < 22 ? 'Good evening' : 'Working late'));
    const _icon = _hr >= 5 && _hr < 18 ? 'sun' : 'moon';
    const _todo = [];
    if (_bd.claimsPending)  { _todo.push('<a href="/admin/staff"><strong>' + Number(_bd.claimsPending) + ' ' + (_bd.claimsPending === 1 ? 'claim' : 'claims') + '</strong></a>'); }
    if (_bd.guestPending)   { _todo.push('<a href="/admin/moderation"><strong>' + Number(_bd.guestPending) + ' guest ' + (_bd.guestPending === 1 ? 'report' : 'reports') + '</strong></a>'); }
    const _verb = (_todo.length === 1 && (_bd.claimsPending + _bd.guestPending) === 1) ? 'needs' : 'need';
  %>
  <header class="page-head adm-greet">
    <div>
      <p class="page-head__eyebrow">Admin console</p>
      <h1>
        <svg class="adm-greet__icon" viewBox="0 0 24 24" aria-hidden="true"><% if (_icon === 'sun') { %><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/><% } else { %><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/><% } %></svg>
        <%= _greet %><%= _first ? ', ' + _first : '' %>
      </h1>
      <p class="muted">
        <% if (_todo.length) { %>
          <%- _todo.join(' and ') %> <%= _verb %> you.
        <% } else { %>
          You're all caught up. Nothing is waiting on you right now.
        <% } %>
      </p>
    </div>
  </header>

  <ul class="my-stats" aria-label="Summary">
    <li style="--i:0"><a href="/admin/moderation"<%- _bd.guestPending ? ' class="adm-stat adm-stat--act"' : '' %>><% if (_bd.guestPending) { %><i class="adm-dot" aria-hidden="true"></i><% } %><strong data-count="<%= _bd.guestPending %>"><%= _bd.guestPending %></strong><span>Guest reports to review<% if (_bd.guestPending) { %> <em>Needs review</em><% } %></span></a></li>
    <li style="--i:1"><a href="/admin/staff"<%- _bd.claimsPending ? ' class="adm-stat adm-stat--act"' : '' %>><% if (_bd.claimsPending) { %><i class="adm-dot" aria-hidden="true"></i><% } %><strong data-count="<%= _bd.claimsPending %>"><%= _bd.claimsPending %></strong><span>Claims waiting<% if (_bd.claimsPending) { %> <em>Needs a decision</em><% } %></span></a></li>
    <li style="--i:2"><a href="/admin/reports"><strong data-count="<%= stats.reportsTotal %>"><%= stats.reportsTotal %></strong><span>Total reports (<%= stats.reportsOpen %> open)</span></a></li>
    <li style="--i:3"><a href="/admin/reports?moderation=rejected"><strong data-count="<%= stats.reportsHidden %>"><%= stats.reportsHidden %></strong><span>Hidden or rejected</span></a></li>
    <li style="--i:4"><a href="/admin/comments"><strong data-count="<%= stats.commentsTotal %>"><%= stats.commentsTotal %></strong><span>Comments</span></a></li>
    <li style="--i:5"><a href="/admin/users"><strong data-count="<%= stats.usersTotal %>"><%= stats.usersTotal %></strong><span>Users</span></a></li>
    <li style="--i:6"><a href="/admin/reports?status=returned"><strong data-count="<%= returnedThisMonth %>"><%= returnedThisMonth %></strong><span>Returned this month</span></a></li>
    <li style="--i:7"><a href="/admin/staff"><strong data-count="<%= agingOver60 %>"><%= agingOver60 %></strong><span>Held over 60 days</span></a></li>
  </ul>

  <%
    // "Reunited this month": returned items vs found items still waiting for their owner.
    const _ret = Number(returnedThisMonth) || 0, _held = Number(heldFound) || 0, _all = _ret + _held;
    const _pct = _all ? Math.round(_ret / _all * 100) : 0;
    const _RC = 2 * Math.PI * 52;
  %>
  <section class="adm-card adm-reunite adm-reveal" aria-labelledby="reunite-h">
    <div class="adm-reunite__ring">
      <svg viewBox="0 0 130 130" aria-hidden="true">
        <defs>
          <linearGradient id="adm-ring-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" style="stop-color:var(--green);stop-opacity:.55"/>
            <stop offset="1" style="stop-color:var(--green)"/>
          </linearGradient>
        </defs>
        <circle class="adm-reunite__track" cx="65" cy="65" r="52"/>
        <circle class="adm-reunite__fill" cx="65" cy="65" r="52" transform="rotate(-90 65 65)"
                style="--full:<%= _RC.toFixed(2) %>;stroke-dasharray:<%= _RC.toFixed(2) %>;stroke-dashoffset:<%= (_RC * (1 - _pct / 100)).toFixed(2) %>"/>
      </svg>
      <p class="adm-reunite__pct"><span class="adm-reunite__main"><span data-count="<%= _pct %>" data-dur="1500"><%= _pct %></span>%</span><span class="adm-reunite__alt" aria-hidden="true"><b><%= _ret %></b>/<%= _all %><small>returned</small></span></p>
    </div>
    <div class="adm-reunite__text">
      <h2 id="reunite-h">Reunited this month</h2>
      <% if (!_all) { %>
        <p class="muted">No found items yet. When one is returned to its owner, it shows up here.</p>
      <% } else { %>
        <p><strong data-count="<%= _ret %>"><%= _ret %></strong> <%= _ret === 1 ? 'item has' : 'items have' %> gone home.
           <strong><%= _held %></strong> <%= _held === 1 ? 'is' : 'are' %> still waiting for <%= _held === 1 ? 'its' : 'their' %> owner.</p>
      <% } %>
      <p class="adm-small"><a href="/admin/reports?status=returned">See returned items</a></p>
    </div>
  </section>

  <div class="adm-cols">
    <section aria-labelledby="recent-r-h">
      <div class="my-section__head"><h2 id="recent-r-h">Latest reports</h2><a class="btn btn--ghost btn--sm" href="/admin/reports">Manage all</a></div>
      <div class="registry-wrap"><table class="registry">
        <thead><tr><th scope="col">Report</th><th scope="col">Visibility</th><th scope="col">Reported</th></tr></thead>
        <tbody>
          <% recentReports.forEach(function (r) { %>
            <tr>
              <td><a class="registry__title" href="/reports/<%= r.reference_no %>"><%= r.title %></a> <code class="registry__ref"><%= r.reference_no %></code></td>
              <td><span class="adm-tag<%= r.moderation_status === 'pending' ? ' adm-tag--strong' : (r.moderation_status === 'rejected' ? ' adm-tag--muted' : '') %>"><%= r.moderation_status === 'approved' ? 'Public' : (r.moderation_status === 'pending' ? 'Awaiting review' : 'Hidden') %></span></td>
              <td><%= fmtDate(r.created_at) %></td>
            </tr>
          <% }); %>
          <% if (!recentReports.length) { %><tr><td colspan="3" class="muted">No reports yet.</td></tr><% } %>
        </tbody>
      </table></div>
    </section>
    <section aria-labelledby="recent-c-h">
      <div class="my-section__head"><h2 id="recent-c-h">Latest comments</h2><a class="btn btn--ghost btn--sm" href="/admin/comments">Manage all</a></div>
      <div class="registry-wrap"><table class="registry">
        <thead><tr><th scope="col">Comment</th><th scope="col">By</th></tr></thead>
        <tbody>
          <% recentComments.forEach(function (c) { %>
            <tr>
              <td class="adm-wrap"><%= c.body.length > 90 ? c.body.slice(0, 90) + '…' : c.body %> <a class="adm-small" href="/reports/<%= c.reference_no %>"><%= c.reference_no %></a></td>
              <td><%= c.author_name %></td>
            </tr>
          <% }); %>
          <% if (!recentComments.length) { %><tr><td colspan="2" class="muted">No comments yet.</td></tr><% } %>
        </tbody>
      </table></div>
    </section>
  </div>

  <section aria-labelledby="source-h">
    <h2 id="source-h">Reports by source</h2>
    <p class="muted">Guest reports are reviewed by staff before they are public.
      <% if (sourceBreakdown.guest.pending > 0) { %>
        <a href="/admin/moderation"><strong><%= sourceBreakdown.guest.pending %> waiting for review</strong></a>.
      <% } else { %>
        <a href="/admin/moderation">Open the review queue</a>.
      <% } %>
    </p>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Source</th><th>Approved</th><th>Pending review</th><th>Rejected</th><th>Total</th></tr></thead>
        <tbody>
          <% [['registered', 'Registered users'], ['guest', 'Guests']].forEach(function (s) {
               const c = sourceBreakdown[s[0]]; %>
            <tr>
              <td><strong><%= s[1] %></strong></td>
              <td><%= c.approved %></td><td><%= c.pending %></td><td><%= c.rejected %></td>
              <td><%= c.approved + c.pending + c.rejected %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <%
    // ---- Chart data, built from the same values the route already passes ----
    const _MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const _now = phParts();
    let _cy = parseInt(_now.year, 10), _cm = parseInt(_now.month, 10);
    const _keys = [];
    for (let i = 0; i < 12; i++) { _keys.unshift({ ym: _cy + '-' + String(_cm).padStart(2, '0'), label: _MON[_cm - 1], full: _MON[_cm - 1] + ' ' + _cy }); _cm--; if (_cm < 1) { _cm = 12; _cy--; } }
    const _byKey = {};
    monthlyCounts.forEach(function (r) { _byKey[r.ym + '|' + r.kind] = Number(r.n) || 0; });
    const _lost  = _keys.map(function (k) { return _byKey[k.ym + '|lost']  || 0; });
    const _found = _keys.map(function (k) { return _byKey[k.ym + '|found'] || 0; });
    const _sum = function (a) { return a.reduce(function (x, y) { return x + y; }, 0); };
    const _top = Math.max(4, Math.max.apply(null, _lost.concat(_found)));
    const _nice = Math.ceil(_top / 4) * 4;
    const W = 640, H = 260, PL = 32, PR = 8, PT = 10, PB = 26, PH = H - PT - PB, STEP = (W - PL - PR) / 12, BW = 16;
    const _y = function (v) { return PT + PH * (1 - v / _nice); };

    // Category donut: top 5 categories with reports, everything else grouped as "Other categories".
    const _cats = categoryDistribution.map(function (c) { return { name: c.name, n: Number(c.n) || 0 }; }).filter(function (c) { return c.n > 0; });
    const _slices = _cats.slice(0, 5);
    if (_cats.length > 5) { _slices.push({ name: 'Other categories', n: _sum(_cats.slice(5).map(function (c) { return c.n; })) }); }
    const _catTotal = _sum(_slices.map(function (c) { return c.n; }));
    const R = 62, CIRC = 2 * Math.PI * R;

    // Top locations: only locations that have reports.
    const _locs = topLocations.map(function (l) { return { name: l.name, n: Number(l.n) || 0 }; }).filter(function (l) { return l.n > 0; });
    const _locMax = _locs.length ? _locs[0].n : 1;
  %>

  <section class="adm-card adm-reveal" aria-labelledby="monthly-h">
    <div class="adm-card__head">
      <h2 id="monthly-h">Lost and found, last 12 months</h2>
      <p class="adm-legend">
        <button type="button" class="adm-toggle" data-series="lost" aria-pressed="true" title="Show or hide lost reports"><i class="adm-key adm-key--lost"></i>Lost <b data-count="<%= _sum(_lost) %>"><%= _sum(_lost) %></b></button>
        <button type="button" class="adm-toggle" data-series="found" aria-pressed="true" title="Show or hide found reports"><i class="adm-key adm-key--found"></i>Found <b data-count="<%= _sum(_found) %>"><%= _sum(_found) %></b></button>
        <button type="button" class="adm-replay" data-replay aria-label="Replay chart animation" title="Replay animation"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.4-5.7"/><path d="M4 4v4.5h4.5"/></svg></button>
      </p>
    </div>
    <svg class="adm-chart" viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="Lost and found reports per month for the last 12 months. The table below has the same numbers.">
      <defs>
        <linearGradient id="adm-g-lost" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--accent-red);stop-opacity:.78"/><stop offset="1" style="stop-color:var(--accent-red)"/>
        </linearGradient>
        <linearGradient id="adm-g-found" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" style="stop-color:var(--brand);stop-opacity:.72"/><stop offset="1" style="stop-color:var(--brand)"/>
        </linearGradient>
      </defs>
      <% [0, 1, 2, 3, 4].forEach(function (t) { const v = _nice / 4 * t; %>
        <line class="adm-grid" style="--i:<%= t %>" x1="<%= PL %>" x2="<%= W - PR %>" y1="<%= _y(v) %>" y2="<%= _y(v) %>"/>
        <text class="adm-axis adm-axis--y" style="--i:<%= t %>" x="<%= PL - 6 %>" y="<%= _y(v) + 4 %>" text-anchor="end"><%= Math.round(v) %></text>
      <% }); %>
      <% _keys.forEach(function (k, i) {
           const gx = PL + i * STEP + (STEP - BW * 2 - 4) / 2; %>
        <g class="adm-month" tabindex="0" role="button" aria-pressed="false" data-m="<%= i %>" data-full="<%= k.full %>" data-lost="<%= _lost[i] %>" data-found="<%= _found[i] %>"
           data-tip="<%= k.full %>: <%= _lost[i] %> lost · <%= _found[i] %> found" aria-label="<%= k.full %>: <%= _lost[i] %> lost, <%= _found[i] %> found">
        <rect class="adm-hit" x="<%= (PL + i * STEP).toFixed(1) %>" y="<%= PT %>" width="<%= STEP.toFixed(1) %>" height="<%= PH + 22 %>" rx="6"/>
        <% [[_lost[i], 'lost', 'Lost', 0], [_found[i], 'found', 'Found', 1]].forEach(function (b) {
             if (!b[0]) return;
             const bh = PH * b[0] / _nice; %>
          <rect class="adm-bar adm-bar--<%= b[1] %>" style="--i:<%= i * 2 + b[3] %>"
                x="<%= (gx + b[3] * (BW + 4)).toFixed(1) %>" y="<%= (PT + PH - bh).toFixed(1) %>" width="<%= BW %>" height="<%= bh.toFixed(1) %>" rx="3"/>
        <% }); %>
        <text class="adm-axis adm-axis--x" style="--i:<%= i %>" x="<%= (PL + i * STEP + STEP / 2).toFixed(1) %>" y="<%= H - 8 %>" text-anchor="middle"><%= k.label %></text>
        </g>
      <% }); %>
    </svg>
    <p class="adm-pin" aria-live="polite" data-hint="Click a month to compare it with the one before.">Click a month to compare it with the one before.</p>
    <details class="adm-data">
      <summary>View as table</summary>
      <div class="table-wrap"><table class="table">
        <thead><tr><th scope="col">Month</th><th scope="col">Lost</th><th scope="col">Found</th></tr></thead>
        <tbody>
          <% _keys.forEach(function (k, i) { %><tr><td><%= k.full %></td><td><%= _lost[i] %></td><td><%= _found[i] %></td></tr><% }); %>
        </tbody>
      </table></div>
    </details>
  </section>

  <div class="adm-cols">
    <section class="adm-card adm-reveal" aria-labelledby="cat-h">
      <h2 id="cat-h">Category distribution</h2>
      <% if (!_catTotal) { %>
        <p class="muted">No reports yet.</p>
      <% } else { %>
        <div class="adm-donut">
          <svg viewBox="0 0 180 180" role="img" aria-label="Reports by category. The list beside the chart has the same numbers.">
            <defs>
              <mask id="adm-donut-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="180" height="180">
                <circle class="adm-donut__sweep" cx="90" cy="90" r="<%= R %>" transform="rotate(-90 90 90)" style="--full:<%= CIRC.toFixed(2) %>;stroke-dasharray:<%= CIRC.toFixed(2) %>"/>
              </mask>
            </defs>
            <circle class="adm-donut__track" cx="90" cy="90" r="<%= R %>"/>
            <g mask="url(#adm-donut-mask)">
            <% let _off = 0; _slices.forEach(function (c, i) {
                 const len = CIRC * c.n / _catTotal, gap = _slices.length > 1 ? 2 : 0; %>
              <circle class="adm-seg adm-c<%= i + 1 %>" tabindex="0" data-seg="<%= i %>" data-n="<%= c.n %>" data-name="<%= c.name %>" cx="90" cy="90" r="<%= R %>" style="--i:<%= i %>;stroke-dasharray:<%= Math.max(len - gap, 0.5).toFixed(2) %> <%= CIRC.toFixed(2) %>"
                      transform="rotate(<%= (-90 + _off / CIRC * 360).toFixed(2) %> 90 90)" data-tip="<%= c.name %>: <%= c.n %> <%= c.n === 1 ? 'report' : 'reports' %>"/>
            <% _off += len; }); %>
            </g>
            <text class="adm-donut__n" x="90" y="92" text-anchor="middle" data-count="<%= _catTotal %>" data-dur="1400"><%= _catTotal %></text>
            <text class="adm-donut__l" x="90" y="110" text-anchor="middle" data-default="reports">reports</text>
          </svg>
          <ul class="adm-donut__list">
            <% _slices.forEach(function (c, i) { %>
              <li style="--i:<%= i %>" data-seg="<%= i %>"><i class="adm-key adm-c<%= i + 1 %>"></i><span><%= c.name %></span><b data-count="<%= c.n %>"><%= c.n %></b></li>
            <% }); %>
          </ul>
        </div>
      <% } %>
    </section>

    <section class="adm-card adm-reveal" aria-labelledby="loc-h">
      <h2 id="loc-h">Top locations</h2>
      <% if (!_locs.length) { %>
        <p class="muted">No reports yet.</p>
      <% } else { %>
        <ol class="adm-hbars">
          <% _locs.forEach(function (l, i) { %>
            <li style="--i:<%= i %>">
              <span class="adm-hbars__name" title="<%= l.name %>"><%= l.name %></span>
              <span class="adm-hbars__track"><i style="--w:<%= (l.n / _locMax * 100).toFixed(1) %>%;--i:<%= i %>"></i></span>
              <b data-count="<%= l.n %>"><%= l.n %></b>
            </li>
          <% }); %>
        </ol>
      <% } %>
    </section>
  </div>

  <p>
    <a class="btn btn--primary" href="/admin/export.csv">Export current month CSV</a>
    <a class="btn btn--ghost" href="/admin/bulk">Bulk status update</a>
    <a class="btn btn--ghost" href="/admin/moderation">Guest report review<% if (sourceBreakdown.guest.pending > 0) { %> (<%= sourceBreakdown.guest.pending %>)<% } %></a>
  </p>
<%- include('../partials/adminClose') %>