<!-- CSPC WhereITis — views/notifications/index.ejs -->
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <%- include('../partials/flash') %>

  <h1>Inbox</h1>
  <nav class="mod-tabs" aria-label="Inbox">
    <a class="mod-tab" href="/notifications" aria-current="page">Notifications<% if (unreadCount) { %> <span class="mod-count"><%= unreadCount %></span><% } %></a>
    <a class="mod-tab" href="/messages">Messages</a>
    <a class="mod-tab mod-tab--end" href="/my-reports">&larr; My reports</a>
  </nav>

  <section class="notif-pref" aria-label="Email alerts">
    <div class="notif-pref__text">
      <strong>Email alerts <span class="notif-pref__state<%= emailPref ? ' is-on' : '' %>"><%= emailPref ? 'On' : 'Off' %></span></strong>
      <span class="muted">
        <%= emailPref
          ? 'We email you when someone claims your report, sends you a message, or your claim is decided.'
          : 'You will only see updates here. Turn this on to also get them by email.' %>
      </span>
    </div>
    <form method="post" action="/notifications/email-preference" class="inline">
      <input type="hidden" name="enabled" value="<%= emailPref ? '0' : '1' %>">
      <button class="btn btn--ghost btn--sm" type="submit"><%= emailPref ? 'Turn off' : 'Turn on' %></button>
    </form>
  </section>

  <% if (notifications.length === 0) { %>
    <div class="empty-state">
      <h3>You're all caught up</h3>
      <p>We'll tell you here when someone files a claim on your report, your claim is decided, or you get a message.</p>
    </div>
  <% } else { %>
    <% if (unreadCount) { %>
      <form method="post" action="/notifications/read-all" class="inline">
        <button class="btn btn--ghost btn--sm" type="submit">Mark all as read</button>
      </form>
    <% } %>
    <ul class="notif-list">
      <% notifications.forEach(function (n) { %>
        <li class="notif<%= n.is_read ? '' : ' notif--unread' %>">
          <div class="notif__main">
            <a href="<%= n.link %>"><%= n.body %></a>
            <span class="muted"><%= fmtDateTime(n.created_at) %></span>
          </div>
          <% if (!n.is_read) { %>
            <form method="post" action="/notifications/<%= n.id %>/read" class="inline">
              <button class="btn btn--ghost btn--sm" type="submit">Mark read</button>
            </form>
          <% } %>
        </li>
      <% }); %>
    </ul>
  <% } %>
</main>

<%- include('../partials/foot') %>
