<!-- CSPC WhereITis — views/nexus/index.ejs — same chrome as Lost / Found boards -->
<%- include('../partials/head', { title: 'Nexus' }) %>
<%- include('../partials/nav') %>

<main id="main" class="container reports-page reports-page--nexus">
  <%- include('../partials/flash') %>

  <section class="board-hero board-hero--found">
    <div>
      <p class="page-head__eyebrow">Command centre</p>
      <h1>Nexus</h1>
      <p>
        Scan for explainable matches and watch the campus pulse.
        <strong><%= counts.openLost %></strong> open lost and
        <strong><%= counts.openFound %></strong> open found right now.
        Every score still comes with a reason.
      </p>
      <div class="board-hero__cta">
        <a class="btn btn--primary" href="/reports/new?kind=lost">I lost something</a>
        <a class="btn btn--ghost" href="/reports/new?kind=found">I found something</a>
      </div>
    </div>
    <ol class="mode-steps">
      <li><strong>Describe</strong><span>Type or speak the item — colour, brand, where it was.</span></li>
      <li><strong>Scan</strong><span>The same rubric as report pages scores candidates and shows why.</span></li>
      <li><strong>Open</strong><span>Jump to the report, then claim or message from there.</span></li>
    </ol>
  </section>

  <div class="board-layout">
    <aside class="side" aria-label="Scan and filter">
      <form class="side__search scan-form" data-scan-form method="get" action="/reports" role="search">
        <label class="visually-hidden" for="scan-q">Item description</label>
        <div class="scan-form__row">
          <textarea id="scan-q" name="q" class="input scan-form__q" rows="3" maxlength="200" required minlength="3"
                    placeholder="e.g. black Nike umbrella, CCS hallway"></textarea>
          <button type="button" class="scan-form__mic" data-voice-search hidden aria-label="Describe by voice">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
          </button>
        </div>
        <label>
          <span class="visually-hidden">Kind</span>
          <select name="kind" id="scan-kind" class="select">
            <option value="">Lost or found</option>
            <option value="lost">I lost this</option>
            <option value="found">I found this</option>
          </select>
        </label>
        <label>
          <span class="visually-hidden">Category</span>
          <select name="category_id" id="scan-cat" class="select">
            <option value="">Any category</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </label>
        <label>
          <span class="visually-hidden">Location</span>
          <select name="location_id" id="scan-loc" class="select">
            <option value="">Anywhere on campus</option>
            <% locations.forEach(function (l) { %>
              <option value="<%= l.id %>"><%= l.name %></option>
            <% }); %>
          </select>
        </label>
        <button class="btn btn--primary btn--sm" type="submit" data-scan-submit>Run scan</button>
      </form>

      <h2 class="side__h">Open by zone</h2>
      <ul class="facet">
        <% if (!zones.length) { %>
          <li><span class="muted">No public locations yet.</span></li>
        <% } %>
        <% zones.forEach(function (z) { %>
          <li>
            <a href="/reports?q=<%= encodeURIComponent(z.zone) %>">
              <%= z.zone %>
              <span><%= z.lost + z.found %></span>
            </a>
          </li>
        <% }); %>
      </ul>

      <p class="side__foot">
        <a href="/reports?kind=lost">Lost board</a><br>
        <a href="/reports?kind=found">Found board</a>
      </p>
    </aside>

    <section aria-label="Campus pulse">
      <div class="list-bar">
        <p class="result-count">
          <strong><%= latest.length %></strong> latest report<%= latest.length === 1 ? '' : 's' %>
          · <%= counts.matched %> matched · <%= counts.returned %> returned
        </p>
        <nav class="seg" aria-label="Boards">
          <a href="/reports?kind=lost">Lost</a>
          <a href="/reports?kind=found">Found</a>
          <a href="/reports">All reports</a>
        </nav>
      </div>

      <div class="scan-results" data-scan-results aria-live="polite"></div>

      <% if (!latest.length) { %>
        <div class="empty-state">
          <h3>The board is quiet</h3>
          <p>File the first report and it will land here.</p>
          <div class="empty-state__actions">
            <a class="btn btn--primary" href="/reports/new?kind=lost">Report lost item</a>
            <a class="btn btn--ghost" href="/reports/new?kind=found">Report found item</a>
          </div>
        </div>
      <% } else { %>
        <ul class="board board--cards" data-pulse>
          <% latest.forEach(function (r) { %>
            <li><%- include('../partials/boardCard', { report: r }) %></li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </div>
</main>

<script src="/js/nexus.js" defer></script>
<%- include('../partials/foot') %>
