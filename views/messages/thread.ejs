<!-- CSPC WhereITis — views/messages/thread.ejs -->
<%
  const _errors = errors || {};
  const _values = values || {};
  const other = conv.owner_user_id === me ? conv.starter_name : conv.owner_name;
  const initials = function (n) {
    return String(n || '?').trim().split(/\s+/).slice(0, 2).map(function (s) { return s.charAt(0); }).join('').toUpperCase() || '?';
  };
  const timeOnly = function (d) { return fmtDateTime(d, { month: undefined, day: undefined, year: undefined }); };
  let _prevDay = null;
  let _prevSender = null;
%>
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>

<main id="main" class="container chat-page">
  <%- include('../partials/flash') %>

  <section class="chat" aria-label="Conversation with <%= other %>">
    <header class="chat__header">
      <a class="chat__back" href="/messages" aria-label="Back to all messages" title="All messages">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      </a>
      <span class="avatar avatar--lg" aria-hidden="true"><%= initials(other) %></span>
      <div class="chat__who">
        <strong class="chat__name"><%= other %></strong>
        <a class="chat__about" href="/reports/<%= conv.reference_no %>">
          <%= conv.report_title %> &middot; <code><%= conv.reference_no %></code>
        </a>
      </div>
    </header>

    <a class="chat__item" href="/reports/<%= conv.reference_no %>" aria-label="About the item: <%= conv.report_title %>">
      <img class="item-thumb" src="<%= conv.report_photo || '/img/placeholder.svg' %>" alt="" referrerpolicy="no-referrer"
           onerror="if(this.getAttribute('src')!=='/img/placeholder.svg'){this.onerror=null;this.src='/img/placeholder.svg';}">
      <span class="chat__item-text">
        <strong><%= conv.report_title %></strong>
        <span class="muted"><%= conv.report_kind === 'lost' ? 'Lost item' : 'Found item' %> &middot; <code><%= conv.reference_no %></code></span>
      </span>
      <span class="chat__item-cta">View report</span>
    </a>

    <ol class="chat__log" id="chat-log" aria-live="polite">
      <% if (messages.length === 0) { %>
        <li class="chat__empty">No messages yet. Say hello below.</li>
      <% } %>
      <% messages.forEach(function (m, idx) {
           const mine = m.sender_user_id === me;
           const day = isoDate(m.created_at);
           const newDay = day !== _prevDay;
           const cont = !newDay && _prevSender === m.sender_user_id;
           _prevDay = day;
           _prevSender = m.sender_user_id; %>
        <% if (newDay) { %>
          <li class="chat__day" role="separator"><span><%= fmtDate(m.created_at) %></span></li>
        <% } %>
        <li class="msg<%= mine ? ' msg--me' : ' msg--them' %><%= cont ? ' msg--cont' : '' %>">
          <% if (!mine) { %>
            <span class="avatar avatar--sm<%= cont ? ' avatar--ghost' : '' %>" aria-hidden="true"><%= initials(m.sender_name) %></span>
          <% } %>
          <div class="msg__bubble">
            <% if (idx === 0) { %>
              <a class="msg__quote" href="/reports/<%= conv.reference_no %>">
                <img class="item-thumb item-thumb--quote" src="<%= conv.report_photo || '/img/placeholder.svg' %>" alt="" referrerpolicy="no-referrer"
                     onerror="if(this.getAttribute('src')!=='/img/placeholder.svg'){this.onerror=null;this.src='/img/placeholder.svg';}">
                <span class="msg__quote-text">
                  <strong><%= conv.report_title %></strong>
                  <small><%= conv.report_kind === 'lost' ? 'Lost item' : 'Found item' %> &middot; <%= conv.reference_no %></small>
                </span>
              </a>
            <% } %>
            <p class="msg__body"><%= m.body %></p>
            <time class="msg__time" datetime="<%= new Date(m.created_at).toISOString() %>"><%= timeOnly(m.created_at) %></time>
          </div>
        </li>
      <% }); %>
      <li id="latest" class="chat__end" aria-hidden="true"></li>
    </ol>

    <form method="post" action="/messages/<%= conv.id %>" class="chat__composer" id="chat-form" novalidate>
      <% if (_errors.body) { %><p class="chat__error" id="err-body" role="alert"><%= _errors.body %></p><% } %>
      <div class="chat__row">
        <label for="body" class="sr-only">Type a message</label>
        <textarea id="body" name="body" class="chat__input" rows="1" maxlength="1000" required
                  placeholder="Type a message..." data-chat-input data-max="1000"
                  <%= _errors.body ? 'aria-invalid="true" aria-describedby="err-body"' : '' %>><%= _values.body || '' %></textarea>
        <button type="submit" class="chat__send" aria-label="Send message" title="Send (Enter)" data-chat-send>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>
        </button>
      </div>
      <p class="chat__hint"><span data-chat-count hidden></span><span class="chat__keys">Enter to send &middot; Shift+Enter for a new line</span></p>
    </form>
  </section>
</main>

<script src="/js/chat.js" defer></script>
<%- include('../partials/foot') %>
