<!-- CSPC WhereITis — views/partials/googleButton.ejs -->
<%
  // googleClientId comes from app.locals (empty until GOOGLE_CLIENT_ID is set).
  // `next` is optional: auth pages that need it pass it; others do not.
  const _googleEnabled = typeof googleClientId !== 'undefined' && !!googleClientId;
  const _googleNext = (typeof next !== 'undefined' && next) ? next : '';
  const _googleMode = (typeof mode !== 'undefined' && mode === 'signup') ? 'signup' : 'signin';
  const _googleLabel = _googleMode === 'signup' ? 'Sign up with Google' : 'Sign in with Google';
%>
<div class="auth-google">
  <div class="auth-google__divider" aria-hidden="true"><span>or</span></div>

  <% if (_googleEnabled) { %>
    <!-- Real Google Identity Services button, rendered by /js/google-signin.js. -->
    <div id="google-btn" class="auth-google__button" data-next="<%= _googleNext %>" data-mode="<%= _googleMode %>"></div>
  <% } else { %>
    <!-- No Client ID configured: behave like Back2You's shortcut — open Google
         in a new tab. It never pretends to sign the user into WhereITis. -->
    <a class="auth-google-custom" href="https://accounts.google.com/" target="_blank" rel="noopener noreferrer"
       aria-label="<%= _googleLabel %> (opens Google in a new tab)" title="Open Google in a new tab">
      <span class="auth-google-custom__icon" aria-hidden="true">
        <svg viewBox="0 0 48 48" focusable="false">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
      </span>
      <span><%= _googleLabel %></span>
    </a>
  <% } %>

  <p class="field-hint auth-google__error" id="google-error" role="alert" hidden></p>
</div>

<% if (_googleEnabled) { %>
  <!-- `defer` on both scripts keeps execution order: Google loads first, then our init. -->
  <script src="https://accounts.google.com/gsi/client" defer></script>
  <script src="/js/google-signin.js" defer></script>
<% } %>
