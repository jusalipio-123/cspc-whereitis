<!-- CSPC WhereITis — views/partials/pagination.ejs -->
<%
  // We do NOT render numbered pages when totalPages > 10 — just
  // Prev/Next. Keeps the UI simple and avoids deep-link pagination
  // issues (stale page numbers, huge page lists on large result sets).
%>
<nav class="pagination" aria-label="Pagination">
  <% if (page > 1) { %>
    <a class="btn btn--ghost btn--sm" href="<%= baseUrl %>&page=<%= page - 1 %>" rel="prev">
      <span aria-hidden="true">&larr;</span> Previous
    </a>
  <% } %>
  <span class="pagination__status">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
    <a class="btn btn--ghost btn--sm" href="<%= baseUrl %>&page=<%= page + 1 %>" rel="next">
      Next <span aria-hidden="true">&rarr;</span>
    </a>
  <% } %>
</nav>