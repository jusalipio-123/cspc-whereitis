<!-- CSPC WhereITis — views/partials/pagination.ejs -->
<%
  // Compact numbered pagination: first, last, and a window around the current page.
  // Keeps Prev/Next so it never produces a huge page list on large result sets.
  const _pages = [];
  for (let i = 1; i <= totalPages; i++) {
    if (i === 1 || i === totalPages || Math.abs(i - page) <= 1) _pages.push(i);
  }
%>
<% if (totalPages > 1) { %>
<nav class="pagination" aria-label="Pagination">
  <% if (page > 1) { %>
    <a class="pagination__link" href="<%= baseUrl %><%= baseUrl.indexOf('?') === -1 ? '?' : '&' %>page=<%= page - 1 %>" rel="prev"><span aria-hidden="true">&larr;</span> Previous</a>
  <% } else { %>
    <span class="pagination__link is-disabled" aria-disabled="true"><span aria-hidden="true">&larr;</span> Previous</span>
  <% } %>

  <ol class="pagination__pages">
    <% let _prev = 0; _pages.forEach(function (n) { %>
      <% if (n - _prev > 1) { %><li class="pagination__gap" aria-hidden="true">&hellip;</li><% } %>
      <li>
        <% if (n === page) { %>
          <span class="pagination__num is-current" aria-current="page"><%= n %></span>
        <% } else { %>
          <a class="pagination__num" href="<%= baseUrl %><%= baseUrl.indexOf('?') === -1 ? '?' : '&' %>page=<%= n %>" aria-label="Page <%= n %>"><%= n %></a>
        <% } %>
      </li>
    <% _prev = n; }); %>
  </ol>

  <% if (page < totalPages) { %>
    <a class="pagination__link" href="<%= baseUrl %><%= baseUrl.indexOf('?') === -1 ? '?' : '&' %>page=<%= page + 1 %>" rel="next">Next <span aria-hidden="true">&rarr;</span></a>
  <% } else { %>
    <span class="pagination__link is-disabled" aria-disabled="true">Next <span aria-hidden="true">&rarr;</span></span>
  <% } %>
</nav>
<% } %>
