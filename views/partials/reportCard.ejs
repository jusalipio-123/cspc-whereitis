<!-- CSPC WhereITis — views/partials/reportCard.ejs -->
<%
  function ageBucket(d) {
    if (d <= 14) return 'fresh';
    if (d <= 60) return 'warm';
    if (d <= 89) return 'old';
    return 'stale';
  }
  const snippet = (report.description || '').slice(0, 110) + ((report.description || '').length > 110 ? '…' : '');
  const href = '/reports/' + report.reference_no;
%>
<article class="card report-card report-card--<%= report.kind %> report-card--<%= report.status %>">
  <a class="report-card__photo-wrap" href="<%= href %>" tabindex="-1" aria-hidden="true">
    <img class="report-card__photo" src="<%= report.photo_url ? report.photo_url : '/img/placeholder.svg' %>" alt="" loading="lazy" referrerpolicy="no-referrer">
    <span class="report-card__kind report-card__kind--<%= report.kind %>"><%= report.kind === 'lost' ? 'Lost' : 'Found' %></span>
  </a>

  <div class="report-card__body">
    <div class="report-card__top">
      <span class="status-pill status-pill--<%= report.status %>"><%= report.status.charAt(0).toUpperCase() + report.status.slice(1) %></span>
      <% if (report.kind === 'found' && typeof report.days_held !== 'undefined' && report.status !== 'returned') { %>
        <span class="days-badge days-badge--<%= ageBucket(report.days_held) %>"><%= report.days_held %> days held</span>
      <% } %>
    </div>

    <h3 class="report-card__title"><a href="<%= href %>"><%= report.title %></a></h3>

    <% if (report.tags && report.tags.length) { %>
      <p class="report-card__tags">
        <% report.tags.forEach(function (t) { %>
          <a class="tag-chip tag-chip--sm" href="/reports?tag=<%= t.slug %>"><%= t.label %></a>
        <% }); %>
      </p>
    <% } %>

    <p class="report-card__snippet"><%= snippet %></p>

    <p class="report-card__meta">
      <span class="report-card__meta-item">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-7.58 7-12a7 7 0 1 0-14 0c0 4.42 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg>
        <%= report.location_name %>
      </span>
      <span class="report-card__meta-item">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
        <%= fmtDate(report.occurred_on) %>
      </span>
    </p>

    <p class="report-card__ref"><code><%= report.reference_no %></code>
      <% if (typeof bookmarked !== 'undefined' && bookmarked) { %>
        <span class="report-card__bookmark">Bookmarked</span>
      <% } %>
    </p>
  </div>
</article>
