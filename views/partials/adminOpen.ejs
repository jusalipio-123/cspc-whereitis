<%- include('head', { title: title }) %>
<%- include('nav') %>
<%
  // Site header and footer stay exactly as on the public pages. The console adds one thing: a left-hand
  // navigation panel built with the site's tokens (card surface, hairline border, brand blue for the active item).
  const _role = (typeof identity !== 'undefined' && identity && identity.role) || 'user';
  const _isAdmin = _role === 'admin';
  const _b = (typeof adminBadges !== 'undefined' && adminBadges) || { guestPending: 0, claimsPending: 0 };
  const _active = (typeof active !== 'undefined') ? active : '';
  const _name = (typeof profileName !== 'undefined' && profileName) ? profileName : ((typeof identity !== 'undefined' && identity) ? identity.studentNo : 'Account');
  const _initials = String(_name).split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w.charAt(0); }).join('').toUpperCase() || 'A';
  const _ico = {
    overview:   '<rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><rect x="14" y="14" width="7" height="7" rx="1.2"/>',
    reports:    '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
    moderation: '<path d="M12 3 4 6v6c0 4.4 3.2 7.6 8 9 4.8-1.4 8-4.6 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
    claims:     '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    comments:   '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>',
    users:      '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18 14.4c2 .7 3.5 2.4 3.5 5.6"/>',
    categories: '<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.2"/>',
    locations:  '<path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>',
    bulk:       '<path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/>',
    export:     '<path d="M12 4v11"/><path d="m7 11 5 5 5-5"/><path d="M5 20h14"/>',
  };
  const _groups = [
    { label: 'Manage', items: [
      { key: 'overview',   href: '/admin',            text: 'Overview',       admin: true },
      { key: 'reports',    href: '/admin/reports',    text: 'Reports',        admin: true },
      { key: 'moderation', href: '/admin/moderation', text: 'Guest review',   badge: _b.guestPending },
      { key: 'claims',     href: '/admin/staff',      text: 'Claims & aging', badge: _b.claimsPending },
      { key: 'comments',   href: '/admin/comments',   text: 'Comments',       admin: true },
      { key: 'users',      href: '/admin/users',      text: 'Users',          admin: true },
    ] },
    { label: 'Settings', items: [
      { key: 'categories', href: '/admin/categories', text: 'Categories',     admin: true },
      { key: 'locations',  href: '/admin/locations',  text: 'Locations',      admin: true },
      { key: 'bulk',       href: '/admin/bulk',       text: 'Bulk update',    admin: true },
      { key: 'export',     href: '/admin/export.csv', text: 'Export CSV',     admin: true },
    ] },
  ];
%>
<main id="main" class="container adm-page">
  <div class="adm-layout">
    <aside class="adm-side" aria-label="Admin navigation">
      <div class="adm-side__who">
        <span class="adm-side__avatar" aria-hidden="true"><%= _initials %></span>
        <div class="adm-side__id">
          <strong title="<%= _name %>"><%= _name %></strong>
          <span><%= _isAdmin ? 'Administrator' : 'Staff' %></span>
        </div>
      </div>
      <nav class="adm-nav" aria-label="Admin sections">
        <% _groups.forEach(function (g) {
             const items = g.items.filter(function (i) { return _isAdmin || !i.admin; });
             if (!items.length) return; %>
          <div class="adm-nav__group">
            <p class="adm-nav__label"><%= g.label %></p>
            <% items.forEach(function (i) { %>
              <a href="<%= i.href %>"<%- _active === i.key ? ' aria-current="page"' : '' %>>
                <svg viewBox="0 0 24 24" aria-hidden="true"><%- _ico[i.key] %></svg>
                <span><%= i.text %></span>
                <% if (i.badge) { %><em class="adm-badge" aria-label="<%= i.badge %> waiting"><%= i.badge %></em><% } %>
              </a>
            <% }); %>
          </div>
        <% }); %>
      </nav>
    </aside>
    <div class="adm-content">
      <%- include('flash') %>
