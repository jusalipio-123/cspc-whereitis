<!-- Password strength meter + live checklist. Cosmetic help only: the server checks every rule again.
     Driven by public/js/app.js (data-pw-meter / data-pw-rules). Works without JS: the list just stays static. -->
<div class="pw-meter" data-pw-meter hidden>
  <div class="pw-meter__track" aria-hidden="true"><i class="pw-meter__bar"></i></div>
  <p class="pw-meter__label" data-pw-label aria-live="polite"></p>
</div>
<ul class="pw-rules" data-pw-rules>
  <li data-rule="length">At least 10 characters</li>
  <li data-rule="mix">Letters plus numbers, symbols or spaces</li>
  <li data-rule="long">14+ characters is even better</li>
</ul>
