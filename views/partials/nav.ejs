<!-- CSPC WhereITis — views/partials/nav.ejs -->
<%
  const _path = (typeof currentPath !== 'undefined' ? currentPath : '/').split('#')[0];
  const _on = function (href) {
    // exact match on path + query so "Lost" and "Found" don't both light up under "Reports"
    return _path === href ? ' aria-current="page"' : '';
  };
%>
<header class="site-header" role="banner">
  <div class="container nav-row">
    <a class="brand" href="/" aria-label="CSPC WhereITis home">
      <img class="brand__seal" src="/img/logo.png" alt="" width="52" height="52"
           onerror="this.style.display='none';">
      <span class="brand-text">
        <strong>CSPC WhereITis</strong>
        <small>Lost &amp; Found</small>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <a href="/"<%- _on('/') %>>Home</a>
      <a href="/reports"<%- _on('/reports') %>>Reports</a>
      <a href="/reports?kind=lost"<%- _on('/reports?kind=lost') %>>Lost</a>
      <a href="/reports?kind=found"<%- _on('/reports?kind=found') %>>Found</a>
      <a href="/help"<%- _on('/help') %>>Help</a>
    </nav>

    <div class="nav-actions">
      <button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch to dark mode" title="Switch to dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <% if (typeof identity !== 'undefined' && identity) { %>
        <a class="nav-link" href="/my-reports">My reports (<%= identity.studentNo %>)</a>
        <form method="post" action="/sign-out" class="inline">
          <input type="hidden" name="next" value="<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
          <button class="nav-link nav-link--hide-sm" type="submit">Sign out</button>
        </form>
      <% } else if (typeof hideAuthActions === 'undefined' || !hideAuthActions) { %>
        <a class="nav-link" href="/sign-in">Sign in</a>
      <% } %>
      <% if (typeof hideAuthActions === 'undefined' || !hideAuthActions) { %>
        <a class="btn btn--primary nav-cta" href="/reports/new"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>Report an item</a>
      <% } %>
    </div>
  </div>
</header>
