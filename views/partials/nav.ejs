<!-- CSPC WhereITis — views/partials/nav.ejs -->
<link rel="stylesheet" href="/css/chat.css?v=6">
<%
  const _path = (typeof currentPath !== 'undefined' ? currentPath : '/').split('#')[0];
  const _on = function (href) {
    // exact match on path + query so "Lost" and "Found" don't both light up under "Reports"
    return _path === href ? ' aria-current="page"' : '';
  };
%>
<header class="site-header" role="banner">
  <div class="container nav-row">
    <a class="brand" href="/" aria-label="CSPC WhereITis home">
      <img class="brand__seal" src="/img/logo.png" alt="" width="52" height="52"
           onerror="this.style.display='none';">
      <span class="brand-text">
        <strong>CSPC WhereITis</strong>
        <small>Lost &amp; Found</small>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <a href="/"<%- _on('/') %>>Home</a>
      <a href="/reports"<%- _on('/reports') %>>Reports</a>
      <a href="/reports?kind=lost"<%- _on('/reports?kind=lost') %>>Lost</a>
      <a href="/reports?kind=found"<%- _on('/reports?kind=found') %>>Found</a>
      <a href="/help"<%- _on('/help') %>>Help</a>
    </nav>

    <div class="nav-actions">
      <button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch to dark mode" title="Switch to dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <% if (typeof identity !== 'undefined' && identity) { %>
        <% const _unread = (typeof unreadCount !== 'undefined' && unreadCount > 0) ? unreadCount : 0; %>
        <a class="nav-icon" href="/notifications"<%- (_path.indexOf('/notifications') === 0 || _path.indexOf('/messages') === 0) ? ' aria-current="page"' : '' %>
           aria-label="Inbox<%= _unread ? ', ' + _unread + ' unread' : '' %>" title="Inbox">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <% if (_unread) { %><span class="nav-icon__badge" aria-hidden="true"><%= _unread > 99 ? '99+' : _unread %></span><% } %>
        </a>
        <%
          const _name = (typeof profileName !== 'undefined' && profileName) ? profileName : identity.studentNo;
        %>
        <details class="profile-menu" data-profile-menu>
          <summary class="profile-chip"<%- _path === '/my-reports' ? ' aria-current="page"' : '' %> aria-label="Account menu: <%= _name %>" title="<%= _name %>">
            <span class="profile-chip__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
            </span>
          </summary>
          <div class="profile-menu__panel">
            <div class="profile-menu__head">
              <strong class="profile-menu__name"><%= _name %></strong>
              <% if (_name !== identity.studentNo) { %><span class="profile-menu__sub"><%= identity.studentNo %></span><% } %>
            </div>
            <a class="profile-menu__item" href="/my-reports"<%- _path === '/my-reports' ? ' aria-current="page"' : '' %>>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg>
              My reports
            </a>
            <form method="post" action="/sign-out" class="profile-menu__form">
              <input type="hidden" name="next" value="<%= typeof currentPath !== 'undefined' ? currentPath : '/' %>">
              <button class="profile-menu__item profile-menu__item--danger" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/></svg>
                Sign out
              </button>
            </form>
          </div>
        </details>
      <% } else if (typeof hideAuthActions === 'undefined' || !hideAuthActions) { %>
        <a class="nav-link" href="/sign-in">Sign in</a>
      <% } %>
    </div>
  </div>
</header>
<script src="/js/nav-menu.js" defer></script>
