  <!-- Title morph (added next to the photo morph above): the item's name flies from its list card to the report
       heading, and back. Same rules as above: progressive enhancement, classic script in <head>, never blocks navigation. -->
  <script>
  (function () {
    if (!('onpagereveal' in window)) { return; }
    var DETAIL = /^\/reports\/(?!new$)([\w-]+)\/?$/;
    var CARD   = '.report-card, .custody, .missing, .registry tbody tr';
    var TITLE  = '.report-card__title, .custody__title, .missing__title, .registry__title';

    function refOf(path) { var m = DETAIL.exec(path); return m ? m[1] : null; }
    function cardTitle(ref) {
      var a = document.querySelector('a[href="/reports/' + ref + '"]');
      var card = a && a.closest(CARD);
      var t = card && card.querySelector(TITLE);
      if (!t) { return null; }
      var r = t.getBoundingClientRect();
      return (r.bottom > 0 && r.top < window.innerHeight) ? t : null;
    }
    function detailTitle() { return document.querySelector('.detail__head h1'); }

    // Name it only for this transition. Shrink-wrapped, so the snapshot is the text itself and not the whole row.
    function share(el, settled) {
      if (!el) { return; }
      var d = el.style.display, w = el.style.width;
      el.style.viewTransitionName = 'report-title';
      el.style.width = 'fit-content';
      if (getComputedStyle(el).display === 'inline') { el.style.display = 'inline-block'; }
      var clear = function () { el.style.viewTransitionName = ''; el.style.width = w; el.style.display = d; };
      Promise.resolve(settled).then(clear, clear);
    }

    window.addEventListener('pageswap', function (e) {
      if (!e.viewTransition || !e.activation) { return; }
