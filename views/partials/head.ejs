  <!-- "Refining" detector: runs before first paint. When the page you are leaving is the SAME page (same path,
       e.g. /reports -> /reports?status=open: status tab, sort, filter, pagination), mark <html class="nav-refine">.
       The stylesheet then swaps the full page-change animation for a still, short cross-fade and app.js skips the
       entrance effects (scroll reveal, count-up), so the header, tabs and toolbar do not move on every click.
       Prerendered pages are marked at the moment they are shown. -->
  <script>
  (function () {
    var root = document.documentElement;
    function mark() {
      var from = '';
      try { var a = window.navigation && navigation.activation; if (a && a.from) { from = a.from.url; } } catch (e) {}
      if (!from) { from = document.referrer; }
      try {
        var u = new URL(from, location.href);
        if (u.origin === location.origin && u.pathname === location.pathname) { root.classList.add('nav-refine'); }
      } catch (e) {}
    }
    mark();
    if (document.prerendering) { document.addEventListener('prerenderingchange', mark, { once: true }); }
  })();
  </script>
