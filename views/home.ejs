 <!-- CSPC WhereITis — views/home.ejs — Home page with hero, counters, latest reports -->
<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/nav') %>

<main id="main">
  <section class="hero hero--campus">
    <div class="veil" aria-hidden="true">
      <span class="tint"></span><span class="b4"></span><span class="b3"></span><span class="b2"></span><span class="b1"></span>
    </div>
    <div class="container hero__overlay">
      <div class="hero__text">
        <p class="hero__kicker">Camarines Sur Polytechnic Colleges</p>
        <h1 class="hero__headline">
          <span>Kung nawala, hanapin dito.</span>
          <span class="hero__headline-accent">Kung nakita, i-report dito.</span>
        </h1>
        <p class="hero__sub">
          Tulong-tulong tayo para sa mas maayos at ligtas na pamayanan sa CSPC.
          Search the list, or file a report in under two minutes.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="/reports/new?kind=lost">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>Report lost item
          </a>
          <a class="btn btn--ghost" href="/reports/new?kind=found">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Report found item
          </a>
        </div>

        <form class="hero__search" method="get" action="/reports" role="search">
          <label for="hero-q" class="visually-hidden">Search lost and found items</label>
          <svg class="hero__search-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="hero-q" class="hero__search-input" type="search" name="q"
                 placeholder="Search lost and found items">
          <kbd class="hero__search-kbd" aria-hidden="true" title="Press / to search">/</kbd>
          <button class="hero__search-btn" type="submit">Search<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
      </div>
    </div>
  </section>

  <div class="container">
    <%- include('partials/flash') %>

    <section class="counters counters--hero" aria-label="Live counts">
      <div class="stat-card">
        <i class="stat-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/></svg></i>
        <div>
          <span>Total Reports</span>
          <strong><%= (counts.openLost || 0) + (counts.openFound || 0) %></strong>
        </div>
      </div>
      <div class="stat-card stat-card--lost">
        <i class="stat-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></i>
        <div>
          <span>Open Lost</span>
          <strong><%= counts.openLost || 0 %></strong>
        </div>
      </div>
      <div class="stat-card stat-card--found">
        <i class="stat-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg></i>
        <div>
          <span>Open Found</span>
          <strong><%= counts.openFound || 0 %></strong>
        </div>
      </div>
      <div class="stat-card stat-card--returned">
        <i class="stat-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/></svg></i>
        <div>
          <span>Returned This Month</span>
          <strong><%= counts.returnedThisMonth || 0 %></strong>
        </div>
      </div>
    </section>

