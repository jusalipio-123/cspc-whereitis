<!-- Found — CLAIM CENTRE: items in custody, browse by category, expiring soon, "This is mine". -->
<section class="board-hero board-hero--found">
  <div>
    <p class="page-head__eyebrow">Claim centre</p>
    <h1>Is something of yours here?</h1>
    <p>These items were turned in and are being kept safe. Find yours, file a claim, then verify it at the office with a valid school ID. Unclaimed items are archived after 90 days.</p>
    <div class="board-hero__cta">
      <a class="btn btn--found" href="/reports/new?kind=found">I found something</a>
      <a class="btn btn--ghost" href="/reports?kind=lost">Lost board</a>
    </div>
  </div>
  <ol class="mode-steps">
    <li><strong>Find your item</strong><span>Browse by category or place.</span></li>
    <li><strong>File a claim</strong><span>Describe details only the owner knows.</span></li>
    <li><strong>Verify &amp; pick up</strong><span>Staff confirm, then release it to you.</span></li>
  </ol>
</section>

<h2 class="section-h">Browse by category</h2>
<ul class="cat-tiles">
  <% facets.categories.forEach(function (c) { %>
    <li><a href="<%= urlWith({ category: filters.category === c.slug ? '' : c.slug }) %>"<%- filters.category === c.slug ? ' aria-current="true" title="Click again to clear this filter"' : '' %>><strong><%= c.n %></strong><span><%= c.name %></span></a></li>
  <% }); %>
</ul>

<% if (typeof expiring !== 'undefined' && expiring.length) { %>
  <section class="expiring" aria-labelledby="exp-h">
    <div class="expiring__head">
      <h2 id="exp-h">Unclaimed for 60+ days</h2>
      <p>These are closest to the 90-day limit. If one is yours, claim it soon.</p>
    </div>
    <ul class="board board--found">
      <% expiring.forEach(function (r) { %><li><%- include('../partials/foundCard', { report: r }) %></li><% }); %>
    </ul>
  </section>
<% } %>

<form class="toolbar" method="get" action="/reports">
  <input type="hidden" name="kind" value="found">
  <% if (filters.category) { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %>
  <div class="toolbar__field toolbar__field--grow">
    <label for="fd-q">Describe your item</label>
    <input id="fd-q" type="search" name="q" class="input" placeholder="e.g. blue umbrella, calculator, keys" value="<%= filters.q || '' %>">
  </div>
  <div class="toolbar__field">
    <label for="fd-loc">Found at</label>
    <select id="fd-loc" name="location" class="select"><option value="">Anywhere</option>
      <% facets.locations.forEach(function (l) { %><option value="<%= l.id %>" <%= String(filters.location) === String(l.id) ? 'selected' : '' %>><%= l.name %> (<%= l.n %>)</option><% }); %>
    </select>
  </div>
  <div class="toolbar__field">
    <label for="fd-from">Found since</label>
    <input id="fd-from" type="date" name="from" class="input" value="<%= filters.from || '' %>">
  </div>
  <div class="toolbar__field">
    <label for="fd-sort">Sort</label>
    <select id="fd-sort" name="sort" class="select">
      <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest first</option>
      <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Held the longest</option>
      <option value="title"  <%= sort === 'title'  ? 'selected' : '' %>>Name A–Z</option>
    </select>
  </div>
  <div class="toolbar__field toolbar__field--check">
    <label class="checkbox"><input type="checkbox" name="scope" value="all" <%= scope === 'all' ? 'checked' : '' %>> Include returned</label>
  </div>
  <div class="toolbar__actions">
    <button class="btn btn--found" type="submit">Find my item</button>
    <a class="btn btn--ghost" href="/reports?kind=found">Reset</a>
  </div>
</form>

<p class="result-count"><strong><%= total %></strong> item<%= total === 1 ? '' : 's' %> <%= scope === 'all' ? '' : 'waiting for their owners' %></p>

<% if (rows.length === 0) { %>
  <div class="empty-state">
    <%- icons.search %>
    <h3>Nothing like that has been turned in yet</h3>
    <p>New items are added every day. You can also report your item as lost so we can match it when it turns up.</p>
    <div class="empty-state__actions">
      <a class="btn btn--ghost" href="/reports?kind=found">Reset filters</a>
      <a class="btn btn--found" href="/reports/new?kind=lost">Report it as lost</a>
    </div>
  </div>
<% } else { %>
  <ul class="board board--found">
    <% rows.forEach(function (r) { %><li><%- include('../partials/foundCard', { report: r }) %></li><% }); %>
  </ul>
  <%- include('../partials/pagination', { page: page, totalPages: totalPages, baseUrl: urlWith({}) }) %>
<% } %>
