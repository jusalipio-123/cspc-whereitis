          <th scope="col">Location</th>
          <th scope="col"><a class="sort-link" href="<%= urlWith({ sort: sort === 'oldest' ? 'recent' : 'oldest' }) %>">Date <%= sort === 'oldest' ? '↑' : sort === 'recent' ? '↓' : '' %></a></th>
          <th scope="col">Age</th>
          <th scope="col">Status</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody>
