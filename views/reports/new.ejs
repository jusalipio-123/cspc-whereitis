<!-- CSPC WhereITis — views/reports/new.ejs -->
<%
  const _allTags = typeof allTags !== 'undefined' ? allTags : [];
  const _selectedTagIds = typeof selectedTagIds !== 'undefined' ? selectedTagIds : [];
  const _errors = errors || {};
  const _kind = values.kind || '';
  const _fieldIds = {
    kind: 'kind-lost', title: 'title', category_id: 'category_id', category_other: 'category_other', location_id: 'location_id', location_other: 'location_other',
    occurred_on: 'occurred_on', holding_location: 'holding_location', description: 'description',
    tag_ids: 'tag-picker', photo_url: 'photo_url'
  };
  const _errorKeys = Object.keys(_fieldIds).filter(function (k) { return _errors[k]; });
  const _today = todayISO();
  const _descLen = (values.description || '').length;
%>
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/nav') %>

<main id="main" class="container report-page">
  <%- include('../partials/flash') %>

  <section class="board-hero board-hero--all">
    <div>
      <p class="page-head__eyebrow">New report</p>
      <h1>Report an item</h1>
      <p>Tell us what was lost or found. The more specific you are, the faster we can match it and get it back to its owner. It takes about two minutes.</p>
    </div>
  </section>

  <% if (_errorKeys.length) { %>
    <div class="form-alert" role="alert" tabindex="-1" id="form-alert">
      <strong>We couldn't submit your report. Please fix <%= _errorKeys.length === 1 ? 'this' : 'these ' + _errorKeys.length + ' items' %>:</strong>
      <ul>
        <% _errorKeys.forEach(function (k) { %>
          <li><a href="#<%= _fieldIds[k] %>"><%= _errors[k] %></a></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <div class="report-layout">
    <form method="post" action="/reports" class="report-form" enctype="multipart/form-data" novalidate data-report-form>

      <!-- 1 · Type -->
      <section class="form-section" aria-labelledby="sec-kind">
        <h2 id="sec-kind" class="form-section__title"><span class="form-section__num" aria-hidden="true">1</span>What would you like to report?</h2>
        <div class="kind-choice" role="radiogroup" aria-labelledby="sec-kind">
          <label class="kind-choice__option">
            <input type="radio" id="kind-lost" name="kind" value="lost" <%= _kind === 'lost' ? 'checked' : '' %> required>
            <span class="kind-choice__body">
              <strong>I lost something</strong>
              <small>Create a lost report so other users can look out for it.</small>
            </span>
          </label>
          <label class="kind-choice__option">
            <input type="radio" id="kind-found" name="kind" value="found" <%= _kind === 'found' ? 'checked' : '' %>>
            <span class="kind-choice__body">
              <strong>I found something</strong>
              <small>Create a found report and tell us where the item is being kept.</small>
            </span>
          </label>
        </div>
        <% if (_errors.kind) { %><p class="field-error"><%= _errors.kind %></p><% } %>
      </section>

      <!-- 2 · Item -->
      <section class="form-section" aria-labelledby="sec-item">
        <h2 id="sec-item" class="form-section__title"><span class="form-section__num" aria-hidden="true">2</span>Item information</h2>

        <div class="field-row">
        <div class="field">
          <label for="title">Item name <span class="req" aria-hidden="true">*</span></label>
          <input id="title" name="title" class="input" type="text" maxlength="120" required autocomplete="off"
                 placeholder="e.g. Black leather wallet"
                 value="<%= values.title || '' %>"
                 <%= _errors.title ? 'aria-invalid="true" aria-describedby="err-title"' : 'aria-describedby="hint-title"' %>>
          <% if (_errors.title) { %><p class="field-error" id="err-title"><%= _errors.title %></p><% } %>
          <p class="field-hint" id="hint-title">A short, specific name. At least 5 characters.</p>
        </div>

        <div class="field">
          <label for="category_id">Category <span class="req" aria-hidden="true">*</span></label>
          <select id="category_id" name="category_id" class="select" required
                  <%= _errors.category_id ? 'aria-invalid="true" aria-describedby="err-cat"' : '' %>>
            <option value="">Select a category</option>
            <%- include('../partials/lookupOptions', { kind: 'category', items: categories, selectedId: values.category_id }) %>
          </select>
          <% if (_errors.category_id) { %><p class="field-error" id="err-cat"><%= _errors.category_id %></p><% } %>
          <%- include('../partials/specifyField', { forSelect: 'category_id', name: 'category_other', label: 'What kind of item is it?', placeholder: 'e.g. Tuning fork, lab coat pin', value: values.category_other, error: _errors.category_other, max: 60, show: !!(categories.find(function (c) { return c.is_other && String(c.id) === String(values.category_id); })) }) %>
        </div>

        </div>

        <div class="field">
          <label for="description">Description <span class="req" aria-hidden="true">*</span></label>
          <textarea id="description" name="description" class="textarea" rows="5" maxlength="1000" required
                    data-charcount data-charcount-min="20" data-charcount-max="1000"
                    placeholder="Colour, brand, size, stickers, scratches, contents, or anything that identifies it."
                    <%= _errors.description ? 'aria-invalid="true" aria-describedby="err-desc"' : 'aria-describedby="hint-desc"' %>><%= values.description || '' %></textarea>
          <% if (_errors.description) { %><p class="field-error" id="err-desc"><%= _errors.description %></p><% } %>
          <p class="field-hint" id="hint-desc">At least 20 characters. Do not include phone numbers or ID numbers.</p>
        </div>

        <% if (_allTags.length) { %>
          <div class="field" role="group" aria-labelledby="tags-label">
            <span id="tags-label" class="label">Tags <span class="optional">(optional, up to 3)</span></span>
            <div class="tag-picker" id="tag-picker" tabindex="-1" data-max-tags="3">
              <% _allTags.forEach(function (t) { %>
                <label class="tag-chip tag-chip--pick">
                  <input type="checkbox" name="tag_ids" value="<%= t.id %>" <%= _selectedTagIds.includes(t.id) ? 'checked' : '' %>>
                  <span><%= t.label %></span>
                </label>
              <% }); %>
            </div>
            <% if (_errors.tag_ids) { %><p class="field-error"><%= _errors.tag_ids %></p><% } %>
          </div>
        <% } %>
      </section>

      <!-- 3 · Where & when -->
      <section class="form-section" aria-labelledby="sec-where">
        <h2 id="sec-where" class="form-section__title"><span class="form-section__num" aria-hidden="true">3</span>Location and date</h2>

        <div class="field-row">
          <div class="field">
            <label for="location_id">
              <span data-kind-label data-lost="Where did you lose it?" data-found="Where did you find it?">Where was it lost or found?</span>
              <span class="req" aria-hidden="true">*</span>
            </label>
            <select id="location_id" name="location_id" class="select" required
                    <%= _errors.location_id ? 'aria-invalid="true" aria-describedby="err-loc"' : '' %>>
              <option value="">Select a location</option>
            <%- include('../partials/lookupOptions', { kind: 'location', items: locations, selectedId: values.location_id }) %>
            </select>
            <% if (_errors.location_id) { %><p class="field-error" id="err-loc"><%= _errors.location_id %></p><% } %>
          <%- include('../partials/specifyField', { forSelect: 'location_id', name: 'location_other', label: 'Specify the place', placeholder: 'e.g. Beside the water refilling station', value: values.location_other, error: _errors.location_other, max: 120, show: !!(locations.find(function (l) { return l.is_other && String(l.id) === String(values.location_id); })) }) %>
          </div>

          <div class="field">
            <label for="occurred_on">
              <span data-kind-label data-lost="Date lost" data-found="Date found">Date lost or found</span>
              <span class="req" aria-hidden="true">*</span>
            </label>
            <input id="occurred_on" name="occurred_on" class="input" type="date" required max="<%= _today %>"
                   value="<%= values.occurred_on || _today %>"
                   <%= _errors.occurred_on ? 'aria-invalid="true" aria-describedby="err-date"' : '' %>>
            <% if (_errors.occurred_on) { %><p class="field-error" id="err-date"><%= _errors.occurred_on %></p><% } %>
          </div>
        </div>

        <div class="field" data-found-only>
          <label for="holding_location">Where is the item now? <span class="req" aria-hidden="true">*</span></label>
          <input id="holding_location" name="holding_location" class="input" type="text" maxlength="160"
                 placeholder="e.g. CCS Dean's Office, 2nd floor"
                 value="<%= values.holding_location || '' %>"
                 <%= _errors.holding_location ? 'aria-invalid="true" aria-describedby="err-hold"' : 'aria-describedby="hint-hold"' %>>
          <% if (_errors.holding_location) { %><p class="field-error" id="err-hold"><%= _errors.holding_location %></p><% } %>
          <p class="field-hint" id="hint-hold">The office or person holding it, so the owner knows where to go.</p>
        </div>
      </section>

      <!-- 4 · Photo -->
      <section class="form-section" aria-labelledby="sec-photo">
        <h2 id="sec-photo" class="form-section__title"><span class="form-section__num" aria-hidden="true">4</span>Photo</h2>
        <div class="field">
          <label for="photo">Upload a photo of the item (optional)</label>
          <input id="photo" name="photo" class="input" type="file" accept="image/jpeg,.jpg,.jpeg,.png,.webp,image/webp" data-photo-file
                 <%= _errors.photo_url ? 'aria-invalid="true" aria-describedby="err-photo"' : 'aria-describedby="hint-photo"' %>>
          <% if (_errors.photo_url) { %><p class="field-error" id="err-photo"><%= _errors.photo_url %><%= _errors.photo_url.indexOf('http') === -1 ? ' Please choose the photo again.' : '' %></p><% } %>
          <p class="field-hint" id="hint-photo">JPG, JPEG, PNG or WebP, up to 5 MB. Everyone browsing the app will see it.</p>
        </div>
        <div class="field">
          <input type="hidden" id="photo_url" name="photo_url" value="">
          <div class="photo-preview" data-photo-preview hidden>
            <img alt="Preview of the item photo" data-photo-img>
            <p class="field-hint" data-photo-msg hidden>We couldn't load that image. Choose a different file.</p>
          </div>
        </div>
      </section>

      <div class="form-actions form-actions--bar">
        <button type="submit" class="btn btn--primary" data-submit>Submit report</button>
        <a href="/reports" class="btn btn--ghost">Cancel</a>
        <p class="form-actions__note"><span class="req" aria-hidden="true">*</span> Required</p>
      </div>
    </form>

    <aside class="report-aside" aria-label="Help">
      <div class="card aside-card">
        <h2>Posting as</h2>
        <p><strong><%= (typeof profileName !== 'undefined' && profileName) ? profileName : (identity ? identity.studentNo : '') %></strong></p>
        <p class="muted">Your name and student number are never shown on the public report.</p>
      </div>

      <div class="card aside-card" data-show-for="none">
        <h2>Tips for a good report</h2>
        <ul>
          <li>Use a specific name, such as "Blue Hydro Flask bottle".</li>
          <li>Mention marks only the owner would know.</li>
          <li>Choose the exact building or area.</li>
        </ul>
      </div>
      <div class="card aside-card" data-show-for="lost" hidden>
        <h2>Lost something?</h2>
        <ul>
          <li>Describe marks, stickers or contents only you would know.</li>
          <li>Choose the last place you remember having it.</li>
          <li>Check the <a href="/reports?kind=found">Found items</a> first; it may already be here.</li>
        </ul>
      </div>
      <div class="card aside-card" data-show-for="found" hidden>
        <h2>Found something?</h2>
        <ul>
          <li>Keep the item safe, or hand it to the office you list.</li>
          <li>Leave out details that would let anyone claim it. Owners prove it with those.</li>
          <li>You review every claim on your report and decide who gets the item.</li>
        </ul>
      </div>

      <div class="card aside-card">
        <h2>What happens next</h2>
        <ol>
          <li>You get a reference number.</li>
          <li>We suggest possible matches.</li>
          <li>Track it any time in <a href="/my-reports">My reports</a>.</li>
        </ol>
      </div>
    </aside>
  </div>
</main>

<%- include('../partials/foot') %>
