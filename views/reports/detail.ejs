<!-- CSPC WhereITis — views/reports/detail.ejs -->
<%
  function ageBucket(d) {
    if (d <= 14) return 'fresh';
    if (d <= 60) return 'warm';
    if (d <= 89) return 'old';
    return 'stale';
  }
  const _identity = typeof identity !== 'undefined' ? identity : null;
%>
<%- include('../partials/head', { title: report.title + ' - ' + report.reference_no }) %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <%- include('../partials/flash') %>

  <article class="detail">
    <div class="detail__top">
      <figure class="detail__photo">
        <img src="<%= report.photo_url || '/img/placeholder.svg' %>" alt="<%= report.photo_url ? 'Photo of ' + report.title : 'No photo provided' %>" fetchpriority="high" referrerpolicy="no-referrer"
             onerror="if(this.getAttribute('src')!=='/img/placeholder.svg'){this.onerror=null;this.src='/img/placeholder.svg';}">
      </figure>
      <div class="detail__info">
        <header class="detail__head">
          <p class="detail__ref">Reference: <code><%= report.reference_no %></code></p>
          <h1><%= report.title %></h1>
          <p class="detail__pills">
            <span class="pill pill--<%= report.kind %>"><%= report.kind === 'lost' ? 'Lost' : 'Found' %></span>
            <span class="pill pill--<%= report.status %>"><%= report.status %></span>
            <% if (report.kind === 'found' && typeof report.days_held !== 'undefined') { %>
              <span class="days-badge days-badge--<%= ageBucket(report.days_held) %>">
                <%= report.days_held %> days held
              </span>
            <% } %>
          </p>
          <% if (report.tags && report.tags.length) { %>
            <p class="report-card__tags">
              <% report.tags.forEach(function (t) { %>
                <a class="tag-chip tag-chip--sm" href="/reports?tag=<%= t.slug %>"><%= t.label %></a>
              <% }); %>
            </p>
          <% } %>
        </header>
        <section class="detail__body">
          <p><%= report.description %></p>
          <dl class="detail__meta">
            <dt>Category</dt><dd><%= report.category_name %></dd>
            <dt>Location</dt><dd><%= report.location_name %></dd>
            <dt>Date <%= report.kind === 'lost' ? 'lost' : 'found' %></dt>
            <dd><%= fmtDate(report.occurred_on, { month: 'long' }) %></dd>
            <% if (report.holding_location) { %>
              <dt>Holding location</dt><dd><%= report.holding_location %></dd>
            <% } %>
            <% if (report.returned_to) { %>
              <dt>Returned to</dt><dd><%= report.returned_to %></dd>
            <% } %>
          </dl>
        </section>

        <section class="detail__actions" aria-label="Actions">
          <% if (report.kind === 'found' && report.status === 'open' && !(_identity && _identity.userId === report.user_id)) { %>
            <% if (!_identity) { %>
              <p class="muted">
                <a href="/sign-in?next=<%= encodeURIComponent('/reports/' + report.reference_no) %>">
                  Sign in
                </a> to file a claim.
              </p>
            <% } %>
            <a class="btn btn--primary" href="/claims/new?report=<%= report.reference_no %>">
              This is mine &mdash; file a claim
            </a>
          <% } %>
          <% if (report.kind === 'lost' && ['open', 'matched'].includes(report.status) && !(_identity && _identity.userId === report.user_id)) { %>
            <% if (!_identity) { %>
              <p class="muted">
                <a href="/sign-in?next=<%= encodeURIComponent('/reports/' + report.reference_no) %>">Sign in</a> to report that you found this.
              </p>
            <% } %>
            <a class="btn btn--primary" href="/reports/new?kind=found&amp;category_id=<%= report.category_id %>&amp;location_id=<%= report.location_id %>">
              I found this
            </a>
          <% } %>
          <% if (_identity && _identity.userId === report.user_id) { %>
            <% if (report.kind === 'lost' && ['open', 'matched'].includes(report.status)) { %>
              <a class="btn btn--primary" href="#returned">Mark as returned</a>
            <% } %>
            <% if (report.status === 'open') { %>
              <a class="btn btn--ghost" href="/reports/<%= report.reference_no %>/edit">
                Edit
              </a>
              <form method="post" action="/reports/<%= report.reference_no %>/withdraw" class="inline" data-confirm="Withdraw this report? This cannot be undone.">
                <button class="btn btn--danger btn--sm" type="submit">Withdraw</button>
              </form>
            <% } %>
          <% } %>
        </section>
      </div>
    </div>

    <% if (!_identity) { %>
      <aside class="upgrade-hint" aria-label="Account benefits">
        <p><strong>Have an account?</strong>
          <a href="/sign-in?next=<%= encodeURIComponent('/reports/' + report.reference_no) %>">Sign in</a>
          or <a href="/register?next=<%= encodeURIComponent('/reports/' + report.reference_no) %>">create one</a>
          to manage claims and comments on your reports.</p>
      </aside>
    <% } %>

    <% if (typeof possibleMatches !== 'undefined' && possibleMatches && possibleMatches.length) { %>
      <section class="matches" aria-labelledby="matches-h">
        <h2 id="matches-h">Possible matches</h2>
        <p class="muted">The system found these reports that might describe the same item. Every score is explained &mdash; nothing is hidden.</p>
        <ul class="card-grid">
          <% possibleMatches.forEach(function (m) { %>
            <li><%- include('../partials/matchCard', { match: m }) %></li>
          <% }); %>
        </ul>
      </section>
    <% } %>

    <% if (_identity && _identity.userId === report.user_id && report.kind === 'lost' && ['open', 'matched'].includes(report.status)) { %>
      <section class="owner-panel" id="returned" aria-labelledby="owner-returned-h">
        <h2 id="owner-returned-h">Got your item back?</h2>
        <p class="field-hint">Once the item is in your hands, mark this report as returned so people stop looking for it.</p>
        <form method="post" action="/reports/<%= report.reference_no %>/returned" class="form"
              data-confirm="Mark this item as returned? This closes the report.">
          <label for="returned_to">Returned by</label>
          <input id="returned_to" name="returned_to" class="input" type="text" minlength="2" maxlength="120" required
                 placeholder="Name of the finder, or the office that handed it to you">
          <button class="btn btn--primary" type="submit">Mark as returned</button>
        </form>
      </section>
    <% } %>

    <section class="comments" id="comments" aria-labelledby="comments-h">
      <h2 id="comments-h">Comments</h2>
      <% const _closed = ["returned", "archived"].includes(report.status); %>
      <% if (!_closed) { %>
      <p class="meeting-note">
        <strong>Where to meet:</strong>
        <% if (report.kind === 'found') { %>
          Verify ownership at <%= report.holding_location || 'the custodian office' %> and bring a valid school ID.
        <% } else { %>
          If you found this item, say so below and hand it to the Security Office or Student Affairs, then the owner can claim it there.
        <% } %>
        Comments are public, so please do not post phone numbers, emails or home addresses.
      </p>
      <% } %>
      <% if (comments.length === 0) { %>
        <p class="muted">No comments yet.</p>
      <% } else { %>
        <ul class="comment-list">
          <% comments.forEach(function (c) { %>
            <li class="comment">
              <p class="comment__meta"><strong><%= c.commenter_name %></strong><% if (report.user_id && c.user_id === report.user_id) { %> <span class="tag-chip tag-chip--sm">Owner</span><% } %> &middot; <%= fmtDateTime(c.created_at) %></p>
              <p class="comment__body"><%= c.body %></p>
            </li>
          <% }); %>
        </ul>
      <% } %>
      <% if (_closed) { %>
        <p class="muted">Comments are closed because this item has been <%= report.status === 'returned' ? 'returned' : 'archived' %>.</p>
      <% } else if (_identity) { %>
        <form method="post" action="/reports/<%= report.reference_no %>/comments" class="form">
          <label for="body">Add a comment</label>
          <textarea id="body" name="body" class="textarea" rows="3" maxlength="500" required
                    aria-describedby="hint-comment" data-charcount data-charcount-max="500"></textarea>
          <p class="field-hint" id="hint-comment">Everyone can read comments. Do not share personal contact details; arrange the handover at an office.</p>
          <button class="btn btn--primary" type="submit">Post comment</button>
        </form>
      <% } else { %>
        <p class="muted"><a href="/sign-in">Sign in</a> to leave a comment.</p>
      <% } %>
    </section>

    <% if (_identity && _identity.userId === report.user_id && report.kind === 'found') { %>
      <section class="owner-panel" id="claims" aria-labelledby="owner-claims-h">
        <h2 id="owner-claims-h">Claims on this report (<%= claims.length %>)</h2>
        <p class="field-hint">You posted this report, so you decide which claim, if any, is approved.</p>
        <% if (claims.length === 0) { %>
          <p class="muted">No claims yet.</p>
        <% } else { %>
          <ul class="claim-list">
            <% claims.forEach(function (c) { %>
              <li class="claim-row">
                <a href="/claims/<%= c.id %>"><%= c.status === 'pending' ? 'Review claim' : 'Claim' %> #<%= c.id %></a>
                by <strong><%= c.claimant_name %></strong> &middot;
                <span class="pill pill--<%= c.status === 'approved' ? 'returned' : c.status === 'rejected' ? 'archived' : 'open' %>"><%= c.status %></span>
                <span class="muted">&middot; <%= fmtDateTime(c.created_at) %></span>
              </li>
            <% }); %>
          </ul>
        <% } %>

        <% if (report.status === 'claimed') { %>
          <form method="post" action="/reports/<%= report.reference_no %>/returned" class="form"
                data-confirm="Mark this item as handed over? This closes the report.">
            <label for="returned_to">Handed over to</label>
            <input id="returned_to" name="returned_to" class="input" type="text" minlength="2" maxlength="120" required
                   placeholder="Name of the person who received the item">
            <button class="btn btn--primary" type="submit">Mark as returned</button>
          </form>
        <% } %>
      </section>
    <% } %>
  </article>
</main>

<%- include('../partials/foot') %>